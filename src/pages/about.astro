---
import BaseLayout from '@layouts/BaseLayout.astro';
import '../styles/grid.css';
import AboutContent from '@components/about/AboutContent.astro';
import { siteConfig } from '@config/site';
---

<BaseLayout title={`About — ${siteConfig.name}`} description={`About ${siteConfig.name}`}>
  <div class="about-page">
    <section class="about grid-1440">
      <AboutContent />
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    background: #121212;
    color: #e8e8e8;
  }

  .about {
    padding-top: calc(128px - var(--nav-height));
    padding-bottom: 6rem;
  }

  .about > :global(*) {
    grid-column: 1 / -1;
  }
</style>

<style is:global>
  body:has(.about-page) {
    background-color: #121212;
  }

  body:has(.about-page) .navbar {
    background-color: #121212;
    backdrop-filter: none;
    border-bottom-color: #121212;
  }

  body:has(.about-page) .footer {
    background-color: #121212;
    border-top-color: #121212;
  }
</style>
