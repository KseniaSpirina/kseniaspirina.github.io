---
import SkillPage from '@components/skills/SkillPage.astro';
import ProjectIntro from '@components/skills/ProjectIntro.astro';
import SanctuaryAnimation from '@components/sanctuary/AnimationSection.astro';
import StellarStraysAnimation from '@components/stellar-strays/AnimationSection.astro';
import DepartureAnimation from '@components/departure/AnimationSection.astro';
import GalleryGrabberAnimation from '@components/gallery-grabber/AnimationSection.astro';

// The "Animation" section of every project that has one, in the order of the projects page.
// Imprisoned and Mourn have no such section and are skipped.
// Each section carries the project name instead of the section name, with a grey line (project type and year) under it.
---

<SkillPage slug="animation" title="Animation" description="Animation across projects: Sanctuary, Stellar Strays, Departure, Gallery Grabber.">
  <div class="sanctuary">
    <SanctuaryAnimation
      id="sanctuary-animation"
      title="Sanctuary"
      subtitle="Team project · Graduation project · 2026"
      intro="In Sanctuary, each character has a set of two animations: idle and walk. Through these animations, I wanted to capture each character’s personality and distinctive traits. All animations were created in Spine 2D, with meshes used for every character."
      riggingTitle="Used rigging tools"
      riggingLists={[
        [
          'Physics constraints add secondary motion, for example on the protagonist, including the ribbons on his shoulder pads.',
          'For the Engineer and the Builder, I used paths and path constraints.',
        ],
        [
          'The Vivaka combines physics constraints on the body with hand-drawn, frame-by-frame animation of its bubbles and wings.',
          'The two guards share a single skeleton and animation set, and skins are used to tell them apart.',
        ],
      ]}>
    <ProjectIntro slot="intro" project="sanctuary" skill="animation" />
  </SanctuaryAnimation>
  </div>
  <StellarStraysAnimation
    id="stellar-strays-animation"
    title="Stellar Strays"
    subtitle="Team project · Game Lab course · 2025"
    intro="For this project, I created a set of animations for Fermi, an alien astronaut, in Spine 2D: idle, walk, jump, and a gravity-shift jump. Through movement, I wanted to capture his personality: confident, self-assured, and brave. At the same time, I slowed the motion down to convey the pull of an alien atmosphere. His scarf is rigged to the engine’s physics, which adds an extra layer of dynamic movement.">
    <ProjectIntro slot="intro" project="stellar-strays" skill="animation" />
  </StellarStraysAnimation>
  <DepartureAnimation id="departure-animation" title="Departure" subtitle="Solo project · Game Animation course · 2025">
    <ProjectIntro slot="intro" project="departure" skill="animation" />
  </DepartureAnimation>
  <GalleryGrabberAnimation id="gallery-grabber-animation" title="Gallery Grabber" subtitle="Team project · Game Lab course · 2025">
    <ProjectIntro slot="intro" project="gallery-grabber" skill="animation" />
  </GalleryGrabberAnimation>
</SkillPage>

<style>
  /* The captions under the last row of videos hang below the Sanctuary canvas (margin 0.4rem + one line of the
     caption font); add that to the section padding so that the visual gap to the next section stays 128px. */
  :global(.skill-page .sanctuary > section.animation) {
    padding-bottom: calc(128px + 0.4rem + 1.2 * clamp(0.625rem, 2.7vw, 1.125rem));
  }

  /* on narrow screens (below ~880px) the caption of the last Medium Vivaki wraps into two lines */
  @media (max-width: 880px) {
    :global(.skill-page .sanctuary > section.animation) {
      padding-bottom: calc(128px + 0.4rem + 2.4 * clamp(0.625rem, 2.7vw, 1.125rem));
    }
  }
</style>
