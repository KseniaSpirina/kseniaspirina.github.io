---
import SkillPage from '@components/skills/SkillPage.astro';
import ProjectIntro from '@components/skills/ProjectIntro.astro';
import SanctuaryEnvironment from '@components/sanctuary/EnvironmentDesignSection.astro';
import ImprisonedEnvironment from '@components/imprisoned/EnvironmentSection.astro';
import MournEnvironment from '@components/mourn/EnvironmentSection.astro';
import DepartureEnvironment from '@components/departure/EnvironmentSection.astro';
import GalleryGrabberEnvironment from '@components/gallery-grabber/EnvironmentSection.astro';

// The "Environment design" section of every project that has one, in the order of the projects page.
// Stellar Strays and Gallery Grabber have "Assets design" next to (or instead of) it, which belongs to no skill page. Each section carries the project name instead
// of the section name, with a grey line (project type and year) under it.
---

<SkillPage slug="environment-design" title="Environment Design" description="Environment design across projects: Sanctuary, Imprisoned, Mourn, Departure, Gallery Grabber.">
  <div class="sanctuary">
    <SanctuaryEnvironment
      id="sanctuary-environment-design"
      title="Sanctuary"
      subtitle="Team project · Graduation project · 2026"
      intro="The Sanctuary is divided between two factions with opposing attitudes toward nature: one seeks to coexist with it, the other to conquer and transform it. The core challenge of the environment design was to give each faction a distinct visual space style, while also resolving how those two styles meet and collide.">
    <ProjectIntro slot="intro" project="sanctuary" skill="environment-design" />
  </SanctuaryEnvironment>
  </div>
  <ImprisonedEnvironment id="imprisoned-environment-design" title="Imprisoned" subtitle="Team project · Digital Game Project course · 2025">
    <ProjectIntro slot="intro" project="imprisoned" skill="environment-design" />
  </ImprisonedEnvironment>
  <MournEnvironment
    id="mourn-environment-design"
    title="Mourn"
    subtitle="Solo project · Indi Games course · 2025"
    intro="Mourn takes place inside the protagonist’s memories of a single day, the day his daughter died. Each location had to show what really happened and, at the same time, reflect how he sees the world. As players move through the locations, they retrace his steps. Since the tragedy, the world has lost all its color and meaning for him, which is why every location is drawn in monochrome.">
    <ProjectIntro slot="intro" project="mourn" skill="environment-design" />
  </MournEnvironment>
  <DepartureEnvironment
    id="departure-environment-design"
    title="Departure"
    subtitle="Solo project · Game Animation course · 2025"
    intro="In Departure, the brief called for an environment that would support the character’s personality and design. Early in the design process, I had already decided that the character lives underground, so a cave was the natural setting. I wanted the space to feel melancholic and slightly unsettling, a fitting home for a character who shares that same quiet sadness and sense of otherness. To create that mood, I built the cave around an underground lake and made it damp and cold, filled with mist, the sound of dripping water, and the rustle of bats’ wings.">
    <ProjectIntro slot="intro" project="departure" skill="environment-design" />
  </DepartureEnvironment>
  <GalleryGrabberEnvironment id="gallery-grabber-environment-design" title="Gallery Grabber" subtitle="Team project · Game Lab course · 2025">
    <ProjectIntro slot="intro" project="gallery-grabber" skill="environment-design" />
  </GalleryGrabberEnvironment>
</SkillPage>
