---
import SkillPage from '@components/skills/SkillPage.astro';
import SanctuaryUI from '@components/sanctuary/UIDesignSection.astro';
import ImprisonedUI from '@components/imprisoned/UiSection.astro';

// The "UI design" section of every project that has one, in the order of the projects page.
// Mourn ("Mechanics and UI"), Stellar Strays and Departure have no section with this name and are skipped.
// Each section carries the project name instead of the section name, with a grey line (project type and year) under it.
---

<SkillPage title="UI Design" description="UI design across projects: Sanctuary and Imprisoned.">
  <div class="sanctuary">
    <SanctuaryUI id="sanctuary-ui-design" title="Sanctuary" subtitle="Team project · Graduation project · 2026" />
  </div>
  <ImprisonedUI id="imprisoned-ui-design" title="Imprisoned" subtitle="Team project · Digital Game Project course · 2025" />
</SkillPage>
