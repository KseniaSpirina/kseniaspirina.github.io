---
import BaseLayout from '@layouts/BaseLayout.astro';
import '../../styles/grid.css';
import '../../styles/project.css';
import '../../styles/sanctuary-text.css';
import Lightbox from '@components/sanctuary/Lightbox.astro';
import SanctuaryCharacters from '@components/sanctuary/CharacterDesignSection.astro';
import MournCharacters from '@components/mourn/CharactersSection.astro';
import StellarStraysCharacters from '@components/stellar-strays/CharacterDesignSection.astro';
import DepartureCharacters from '@components/departure/CharacterDesignSection.astro';

// The "Character design" section of every project that has one, in the order of the projects page.
// Imprisoned has no such section and is skipped. Each section carries the project name instead of the
// section name, with a grey line (project type and year) under it.
---

<BaseLayout
  title="Character Design — Ksenia Spirina"
  description="Character design across projects: Sanctuary, Mourn, Stellar Strays, Departure."
>
  <div class="skill-page project-page text-v2">
    <section class="skill-hero grid-1440">
      <h1 class="skill-title">Character Design</h1>
    </section>

    <div class="sanctuary">
      <SanctuaryCharacters id="sanctuary-character-design" title="Sanctuary" subtitle="Team project · Graduation project · 2026" />
    </div>

    <MournCharacters id="mourn-character-design" title="Mourn" subtitle="Solo project · Indi Games course · 2025" />

    <StellarStraysCharacters id="stellar-strays-character-design" title="Stellar Strays" subtitle="Team project · Game Lab course · 2025" />

    <div class="skill-last">
      <DepartureCharacters id="departure-character-design" title="Departure" subtitle="Solo project · Game Animation course · 2025" />
    </div>

    <Lightbox />
  </div>
</BaseLayout>

<style>
  .skill-page {
    background: #121212;
    color: #e8e8e8;
  }

  .skill-hero {
    padding-top: calc(128px - var(--nav-height));
    /* page title -> first section: 64px */
    padding-bottom: 64px;
  }

  /* the Sanctuary section brings its own 64px above and below: here sections are 128px apart, like on the project pages */
  :global(.skill-page .sanctuary .character-design) {
    padding-top: 0;
    padding-bottom: 128px;
  }

  /* last section -> footer: 128px (the footer has its own 128px margin) */
  :global(.skill-last .project-section) {
    padding-bottom: 0;
  }

  .skill-hero > :global(*) {
    grid-column: 1 / -1;
  }

  /* Unbounded: the line box starts 128px from the top of the page, the empty space below the capitals is trimmed */
  .skill-title {
    display: flow-root;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .skill-title::after {
    content: '';
    display: block;
    height: 0;
    margin-bottom: -0.25em;
  }
</style>

<style is:global>
  body:has(.skill-page) {
    background-color: #121212;
  }

  body:has(.skill-page) .navbar {
    background-color: #121212;
    backdrop-filter: none;
    border-bottom-color: #121212;
  }

  body:has(.skill-page) .footer {
    background-color: #121212;
    border-top-color: #121212;
  }
</style>
