---
import SkillPage from '@components/skills/SkillPage.astro';
import SanctuaryCharacters from '@components/sanctuary/CharacterDesignSection.astro';
import MournCharacters from '@components/mourn/CharactersSection.astro';
import StellarStraysCharacters from '@components/stellar-strays/CharacterDesignSection.astro';
import DepartureCharacters from '@components/departure/CharacterDesignSection.astro';

// The "Character design" section of every project that has one, in the order of the projects page.
// Imprisoned has no such section and is skipped. Each section carries the project name instead of the
// section name, with a grey line (project type and year) under it.
---

<SkillPage title="Character Design" description="Character design across projects: Sanctuary, Mourn, Stellar Strays, Departure.">
  <div class="sanctuary">
    <SanctuaryCharacters id="sanctuary-character-design" title="Sanctuary" subtitle="Team project · Graduation project · 2026" />
  </div>
  <MournCharacters id="mourn-character-design" title="Mourn" subtitle="Solo project · Indi Games course · 2025" />
  <StellarStraysCharacters id="stellar-strays-character-design" title="Stellar Strays" subtitle="Team project · Game Lab course · 2025" />
  <DepartureCharacters id="departure-character-design" title="Departure" subtitle="Solo project · Game Animation course · 2025" />
</SkillPage>
