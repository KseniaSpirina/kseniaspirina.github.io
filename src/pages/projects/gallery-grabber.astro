---
import BaseLayout from '@layouts/BaseLayout.astro';
import '../../styles/grid.css';
import '../../styles/project.css';
import Lightbox from '@components/sanctuary/Lightbox.astro';
import ProjectNavArrows from '@components/sanctuary/ProjectNavArrows.astro';
import ProjectPager from '@components/sanctuary/ProjectPager.astro';
import HeroSection from '@components/gallery-grabber/HeroSection.astro';
import ContributionSection from '@components/gallery-grabber/ContributionSection.astro';
import CharacterDesignSection from '@components/gallery-grabber/CharacterDesignSection.astro';
import AnimationSection from '@components/gallery-grabber/AnimationSection.astro';
import EnvironmentSection from '@components/gallery-grabber/EnvironmentSection.astro';
import AssetsSection from '@components/gallery-grabber/AssetsSection.astro';
import ContactSection from '@components/project/ContactSection.astro';
---

<BaseLayout
  title="Gallery Grabber — Ksenia Spirina"
  description="Top-down stealth game about a museum janitor secretly stealing priceless artifacts to fund her dream vacation. Made in the Game Lab course."
>
  <div class="project-page text-v2">
    <ProjectNavArrows prevHref="/projects/departure" nextHref="/projects/other-projects" />

    <HeroSection />
    <ContributionSection />
    <CharacterDesignSection />
    <AnimationSection />
    <EnvironmentSection />
    <AssetsSection />
    <ContactSection />

    <ProjectPager prevHref="/projects/departure" nextHref="/projects/other-projects" />

    <Lightbox />
  </div>
</BaseLayout>

<style is:global>
  body:has(.project-page) {
    background-color: #121212;
  }

  body:has(.project-page) .navbar {
    background-color: #121212;
    backdrop-filter: none;
    border-bottom-color: #121212;
  }

  body:has(.project-page) .footer {
    background-color: #121212;
    border-top-color: #121212;
  }
</style>
