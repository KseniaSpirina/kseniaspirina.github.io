---
import BaseHead from '@components/layout/BaseHead.astro';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import '../styles/theme.css';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

// Transparent videos: Safari / iOS cannot show the alpha channel of a VP9 .webm (black or white background).
// For every public/**/name.mov (HEVC with alpha) the page uses it instead of name.webm in WebKit browsers.
const publicDir = path.join(process.cwd(), 'public');
const alphaMov: string[] = [];
(function walk(dir: string) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) walk(full);
    else if (entry.name.endsWith('.mov')) alphaMov.push('/' + path.relative(publicDir, full).split(path.sep).join('/'));
  }
})(publicDir);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ alphaMov }}>
      // WebKit (Safari, every browser on iOS): use the HEVC-with-alpha .mov instead of the transparent .webm
      (function () {
        var ua = navigator.userAgent;
        var isWebKit =
          /iPhone|iPad|iPod/.test(ua) ||
          (/AppleWebKit/.test(ua) && !/(Chrome|Chromium|Edg|OPR|Android)\//.test(ua));
        if (!isWebKit || !alphaMov.length) return;
        var have = {};
        alphaMov.forEach(function (p) { have[p.replace(/\.mov$/, '.webm')] = p; });
        document.querySelectorAll('video[src], video[data-lazy-src]').forEach(function (v) {
          var attr = v.hasAttribute('data-lazy-src') ? 'data-lazy-src' : 'src';
          var cur = v.getAttribute(attr);
          if (cur && have[cur]) {
            v.setAttribute(attr, have[cur]);
            if (attr === 'src') {
              v.load();
              var p = v.play();
              if (p && p.catch) p.catch(function () {});
            }
          }
        });
      })();
    </script>
  </body>
</html>
