---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** in the order of the sections on the page: left to right, top to bottom */
  projects: { id: string; title: string; cover: ImageMetadata }[];
}

const { projects } = Astro.props;
---

<!-- The overview of the projects, in the place of a trailer: the picture of every project is 2 columns wide, in the
     order of the sections. The class "trailer" is what the Contents menu aligns its top to. Hovering a project name in
     the menu highlights its picture with a plate (script below). -->
<div class="trailer overview">
  {projects.map(project => (
    <a class="tile" href={`#${project.id}`} data-project={project.id} aria-label={project.title}>
      <Image src={project.cover} alt={project.title} widths={[300, 600, 900]} sizes="(max-width: 1260px) 50vw, 282px" loading="eager" />
    </a>
  ))}
</div>

<style>
  /* 8 columns as on the grid: a picture takes 2, so three stand in a row in the 6 columns where the trailer is */
  .overview {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    /* 24px between the columns; 64px between the rows = the plates (32px above and under every picture) touch */
    column-gap: 24px;
    row-gap: 64px;
    /* page title -> the layout: 64px; the hero grid already puts its row gap (24px, 16px on phones) between them */
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .overview {
      margin-top: 48px;
    }
  }

  /* the plate, as behind the projects in the list of projects: a gutter (24px) at the sides, 32px above and under the
     picture; the picture keeps its place (padding and the same negative margin) */
  .tile {
    grid-column: span 2;
    display: block;
    padding: 32px 24px;
    margin: -32px -24px;
    border-radius: 4px;
    transition: background-color 150ms ease;
  }

  .tile:nth-child(3n + 2) {
    grid-column: 3 / span 2;
  }

  .tile:nth-child(3n) {
    grid-column: 5 / span 2;
  }

  /* Astro puts max-width (the last size of "sizes") on the picture in the page: the picture is as wide as its tile */
  .tile :global(img) {
    display: block;
    width: 100%;
    max-width: none !important;
    aspect-ratio: 282 / 159;
    object-fit: cover;
    border-radius: 4px;
  }

  /* the project whose name is under the cursor in the menu, or the picture under the cursor */
  .tile.is-highlighted {
    background-color: rgba(255, 255, 255, 0.04);
  }

  @media (hover: hover) {
    .tile:hover {
      background-color: rgba(255, 255, 255, 0.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }

  /* 4-column grid: a picture is still 2 columns wide, two in a row */
  @media (max-width: 1260px) {
    .tile,
    .tile:nth-child(3n + 2),
    .tile:nth-child(3n) {
      grid-column: span 4;
    }

    .overview {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Menu -> layout: the plate appears behind the picture of the project while its name is hovered (or focused) in the menu
  function initHighlight() {
    document.querySelectorAll<HTMLAnchorElement>('[data-side-menu] a[data-menu-link]').forEach(link => {
      const id = link.getAttribute('href')?.slice(1);
      const tile = id ? document.querySelector<HTMLElement>(`.overview [data-project="${id}"]`) : null;
      if (!tile) return;
      const on = () => tile.classList.add('is-highlighted');
      const off = () => tile.classList.remove('is-highlighted');
      link.addEventListener('mouseenter', on);
      link.addEventListener('mouseleave', off);
      link.addEventListener('focus', on);
      link.addEventListener('blur', off);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHighlight);
  } else {
    initHighlight();
  }
</script>
