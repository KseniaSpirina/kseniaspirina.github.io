---
interface Props {
  /** paragraphs of the project description */
  description: string[];
  /** what I did on the project */
  role: string;
}

const { description, role } = Astro.props;
---

<!-- Project description (3 columns) and Credits (3 columns, one column gap) right under the project name and its grey line,
     like on the Skills pages. The credits come in the default slot. -->
<div class="block skill-intro">
  <div class="cols">
    <div class="gc-1-3">
      <h3 class="p-label">Project description</h3>
      <div class="after-label">
        {description.map((paragraph) => <p class="p-text">{paragraph}</p>)}
      </div>
      <h3 class="p-label role-label">My role</h3>
      <p class="p-text after-label">{role}</p>
    </div>
    <div class="gc-5-3">
      <h3 class="p-label">Credits</h3>
      <div class="after-label">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  /* description -> "MY ROLE" 96px (block to block) */
  .role-label {
    margin-top: 96px;
  }
</style>
