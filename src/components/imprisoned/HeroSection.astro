---
import ImprisonedCredits from '../credits/ImprisonedCredits.astro';
import SideMenu from '../sanctuary/SideMenu.astro';
import ItchButton from '../project/ItchButton.astro';
import TrailerPlayer from '../sanctuary/TrailerPlayer.astro';
import LightboxImage from '../sanctuary/LightboxImage.astro';
import g3 from '@assets/imprisoned/gallery/gallery-3.png';
import g4 from '@assets/imprisoned/gallery/gallery-4.png';
import g5 from '@assets/imprisoned/gallery/gallery-5.png';
import g6 from '@assets/imprisoned/gallery/gallery-6.png';
import g7 from '@assets/imprisoned/gallery/gallery-7.png';
import cover from '@assets/projects/imprisned-title-picture.jpg';

const menuLinks = [
  { label: 'OVERVIEW', href: '#top' },
  { label: 'CONTRIBUTION', href: '#contribution' },
  { label: 'ENVIRONMENT DESIGN', href: '#environment-design' },
  { label: 'VISUAL EFFECTS DESIGN', href: '#visual-effects-design' },
  { label: 'UI DESIGN', href: '#ui-design' },
  { label: 'CUTSCENES', href: '#cutscenes' },
  { label: 'CONTACT', href: '#contact' },
];

// Gallery under the project description and credits (it used to be in the Contribution section):
// two pictures per row, each 4 of the 8 columns wide
const gallery = [
  { src: g3, start: 1 },
  { src: g4, start: 5 },
  { src: g5, start: 1 },
  { src: g6, start: 5 },
  { src: g7, start: 1 },
];

const trailerSrc = 'https://www.youtube-nocookie.com/embed/QRraN709p1I';
---

<section class="hero grid-1440" id="top">
  <SideMenu links={menuLinks} />

  <div class="inner">
    <h1>Imprisoned</h1>
    <p class="type">Team project · Digital Game Project course · 2025</p>

    <div class="trailer">
      <TrailerPlayer cover={cover} src={trailerSrc} title="Imprisoned trailer" />
    </div>

    <div class="cols info">
      <div class="gc-1-3">
        <h3 class="p-label">Project description</h3>
        <p class="p-text after-label">
          Imprisoned is a top-down action game where movement is both your weapon and your life.
          Playing as a newborn slime, shaped from the final strength of an ancient being, the
          player must free their creator from a prison by collecting keys scattered across
          floating islands, each guarded by relentless wardens. As the slime moves, its body
          spreads into a deadly trail that destroys enemies, though every motion costs the
          player <br class="br-wide" />a part of themselves.
        </p>
        <ItchButton href="https://ksenia-spirina.itch.io/imprisoned" />
      </div>
      <div class="gc-5-3">
        <h3 class="p-label">Credits</h3>
        <div class="after-label">
          <ImprisonedCredits cls="p-text" />
        </div>
      </div>
    </div>

    <div class="cols gallery block-gap">
      {gallery.map((item, i) => (
        <div class="cell" style={`--start: ${item.start};`}>
          <LightboxImage
            src={item.src}
            alt={`Imprisoned gameplay screenshot ${i + 1}`}
            widths={[400, 700, 1000, 1400, 1920]}
            sizes="(max-width: 640px) 95vw, (max-width: 1260px) 50vw, 588px"
            group="imprisoned-gallery"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cell {
    grid-column: var(--start) / span 4;
  }

  @media (max-width: 1260px) {
    .cell {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .cell {
      grid-column: 1 / -1;
    }
  }

  .hero {
    position: relative;
    padding-top: calc(128px - var(--nav-height));
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .inner {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .type {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #9a9a9a;
  }

  @supports (text-box-trim: trim-both) {
    h1 {
      text-box: trim-end cap alphabetic;
    }

    .type {
      margin-top: 32px;
      text-box: trim-start cap alphabetic;
    }
  }

  .trailer {
    position: relative;
    width: 100%;
    max-width: 894px;
    aspect-ratio: 894 / 503;
    margin-top: 64px;
    background: rgba(217, 217, 217, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .trailer iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .info {
    margin-top: 96px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }

    .type {
      font-size: 1.25rem;
    }
  }
</style>
