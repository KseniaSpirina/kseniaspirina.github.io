---
interface Props {
  id: string;
  title: string;
  /** optional grey line under the section name (used on the Skills pages: project type and year) */
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section class="project-section grid-1440" id={id}>
  <div class="inner">
    <span class="divider"></span>
    <h2>{title}</h2>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <div class="body"><slot /></div>
  </div>
</section>

<style>
  .project-section {
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .inner {
    grid-column: 1 / -1;
  }

  .divider {
    display: block;
    width: 588px;
    max-width: 100%;
    height: 0;
    border-top: 4px solid #4361ee;
  }

  h2 {
    margin: 32px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 36px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  /* grey line under the section name: name -> line 32px, line -> content 64px (glyph to glyph).
     Inter 24px on a 30px line: 6.28px empty above the capitals, 6.27px below the baseline. */
  .subtitle {
    display: flow-root;
    margin: 32px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 30px;
    color: #9a9a9a;
  }

  .subtitle::before,
  .subtitle::after {
    content: '';
    display: block;
    height: 0;
  }

  .subtitle::before {
    margin-top: -6.28px;
  }

  .subtitle::after {
    margin-bottom: -6.27px;
  }

  .body {
    margin-top: 64px;
  }

  @media (max-width: 640px) {
    h2 {
      font-size: 1.75rem;
    }
  }
</style>
