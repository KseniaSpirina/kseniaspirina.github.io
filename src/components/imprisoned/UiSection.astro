---
import { Image } from 'astro:assets';
import ProjectSection from './ProjectSection.astro';
import LazyVideo from './LazyVideo.astro';

import uiGallery1 from '@assets/imprisoned/ui/ui-gallery-1.jpg';
import uiGallery2 from '@assets/imprisoned/ui/ui-gallery-2.jpg';
import uiGallery3 from '@assets/imprisoned/ui/ui-gallery-3.jpg';
import dialogue1 from '@assets/imprisoned/ui/dialogue-ui-1.png';
import dialogue2 from '@assets/imprisoned/ui/dialogue-ui-2.png';
import dialogue3 from '@assets/imprisoned/ui/dialogue-ui-3.png';
import healthbarUi from '@assets/imprisoned/ui/healthbar-ui.png';
import enemyCounter from '@assets/imprisoned/ui/enemy-counter.png';
import timerCast from '@assets/imprisoned/ui/timer-cast.png';

const v = (name: string) => `/imprisoned/videos/${name}.webm`;
const pct = (value: number, total: number) => `${(value / total) * 100}%`;
const CW = 1200;

// Sections placed by hand, as in the Figma file (px, relative to the section label).
const healthH = 274;
const counterH = 286;
const timerH = 698;

const pos = (x: number, y: number, w: number, h: number | null, ch: number) =>
  `--l: ${pct(x, CW)}; --t: ${pct(y, ch)}; --w: ${pct(w, CW)};${h ? ` --h: ${pct(h, ch)};` : ''}`;

const { id = 'ui-design', title = 'UI design', subtitle } = Astro.props;
---

<ProjectSection {id} {title} {subtitle}>
  <div class="block">
    <h3 class="p-label">UI design approach</h3>
    <div class="cols after-label">
      <div class="gc-1-3">
        <p class="p-text">
          The UI uses a minimalist style with flat colors, chosen for maximum readability in an
          action game. Main elements are mostly in the slime's colors, with a contrasting sand
          color added for decorative details. The decorative elements reference slime texture and
          bubbles, tying the interface to the world of the main characters.
        </p>
      </div>
    </div>
  </div>

  <div class="block">
    <h3 class="p-label">Dialogue UI</h3>
    <div class="cols after-label">
      <div class="gc-1-2">
        <ul class="p-list">
          <li>Scalable decorative frame for the dialogue text</li>
          <li>Slime Prime portrait, drawn from the 3D model</li>
          <li>Frame ornaments based on slime and bubbles, tying the design to the main slime characters</li>
          <li>Text can be accompanied by stylized icons or icons based on in-game models</li>
        </ul>
      </div>
      <div class="gc-4-5">
        <Image src={uiGallery1} alt="Dialogue UI in the game" widths={[700, 1100, 1500]} sizes="(max-width: 1440px) 60vw, 741px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>

    <div class="cols block-gap">
      <div class="gc-2-6">
        <Image src={dialogue2} alt="Dialogue frame, variant 1" widths={[900, 1400, 1800]} sizes="(max-width: 1440px) 80vw, 892px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>
    <div class="cols block-gap">
      <div class="gc-2-6">
        <Image src={dialogue1} alt="Dialogue frame, variant 2" widths={[900, 1400, 1800]} sizes="(max-width: 1440px) 80vw, 893px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>
    <div class="cols block-gap">
      <div class="gc-2-6">
        <Image src={dialogue3} alt="Dialogue frame, variant 3" widths={[900, 1400, 1800]} sizes="(max-width: 1440px) 80vw, 893px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>
  </div>

  <div class="block">
    <h3 class="p-label">General UI</h3>
    <div class="cols after-label">
      <div class="gc-1-2">
        <p class="p-text">
          In most of the game, the player must defeat all enemies to complete a level.<br />
          The UI therefore consists of two elements: a health bar and an enemy counter.
        </p>
      </div>
      <div class="gc-4-5">
        <Image src={uiGallery2} alt="General UI in the game" widths={[700, 1100, 1500]} sizes="(max-width: 1440px) 60vw, 742px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>
  </div>

  <div class="block">
    <div class="offgrid" style={`--cw: ${CW}; --ch: ${healthH};`}>
      <h3 class="p-label og" style="--l: 0%; --t: 0%; --w: auto;">Health bar</h3>
      <div class="og" style={pos(302, 48, 194.5, 216.5, healthH)}>
        <Image src={healthbarUi} alt="Health bar frame" widths={[400, 778]} sizes="195px" loading="lazy" />
      </div>
      <div class="og" style={pos(592, 41, 282, null, healthH)}>
        <ul class="p-list">
          <li>Slime-shaped health indicator that fills or empties with remaining health</li>
          <li>The fill level matches the growth and shrinking of the player's slime model</li>
          <li>Ability icon</li>
          <li>Decorative frame</li>
        </ul>
      </div>
      <div class="og sq" style={pos(960, 31, 240, 243, healthH)}>
        <LazyVideo src={v('lifesbar')} ratio="1 / 1" label="Health bar" />
      </div>
    </div>
  </div>

  <div class="block">
    <div class="offgrid" style={`--cw: ${CW}; --ch: ${counterH};`}>
      <h3 class="p-label og" style="--l: 0%; --t: 0%; --w: auto;">Enemies counter</h3>
      <div class="og" style={pos(327, 50, 184, 180.5, counterH)}>
        <Image src={enemyCounter} alt="Enemies counter frame" widths={[368, 736]} sizes="184px" loading="lazy" />
      </div>
      <div class="og" style={pos(592, 50, 282, null, counterH)}>
        <ul class="p-list">
          <li>Counter that fills with each defeated enemy and shows how many remain before the passage to the next level opens</li>
          <li>Skull and locked padlock details visually link the enemies' deaths to the locked exit</li>
          <li>Decorative frame</li>
        </ul>
      </div>
      <div class="og sq" style={pos(994, 50, 206, 207, counterH)}>
        <LazyVideo src={v('enemies-counter')} ratio="1 / 1" label="Enemies counter" />
      </div>
    </div>
  </div>

  <div class="block">
    <h3 class="p-label">Final lvl UI</h3>
    <div class="cols after-label">
      <div class="gc-1-2">
        <p class="p-text">
          The final level changes the format. Instead of defeating all enemies, the player must
          defend Slime Prime for a set amount of time. The enemy counter is therefore replaced by
          a timer.
        </p>
      </div>
      <div class="gc-4-5">
        <Image src={uiGallery3} alt="Final level UI" widths={[700, 1100, 1500]} sizes="(max-width: 1440px) 60vw, 742px" quality={90} loading="lazy" class="media-img" />
      </div>
    </div>
  </div>

  <div class="block">
    <div class="offgrid" style={`--cw: ${CW}; --ch: ${timerH};`}>
      <h3 class="p-label og" style="--l: 0%; --t: 0%; --w: auto;">Cast timer</h3>
      <div class="og" style={pos(361, 87, 74, 540, timerH)}>
        <Image src={timerCast} alt="Cast timer" widths={[148, 296]} sizes="74px" loading="lazy" />
      </div>
      <div class="og" style={pos(537, 186, 282, null, timerH)}>
        <ul class="p-list">
          <li>Stylized display of the towers on the level that Slime Prime destroys with his cast</li>
          <li>Cast turns red when enemies attack Slime Prime, matching the effect around the towers on the map</li>
        </ul>
      </div>
      <div class="vid-pair">
        <div class="vid-col">
          <div class="og" style={pos(926, 57, 112, 595, timerH)}>
            <LazyVideo src={v('timer-normal')} ratio="160 / 896" label="Regular cast" />
          </div>
          <p class="p-caption og cap" style={pos(929, 676, 106, null, timerH)}>Regular cast</p>
        </div>
        <div class="vid-col">
          <div class="og" style={pos(1088, 57, 112, 595, timerH)}>
            <LazyVideo src={v('timer-danger')} ratio="160 / 896" label="Endangered cast" />
          </div>
          <p class="p-caption og cap" style={pos(1088, 676, 108, null, timerH)}>Endangered cast</p>
        </div>
      </div>
    </div>
  </div>
</ProjectSection>

<style>
  .cap {
    margin: 0;
    white-space: nowrap;
  }

  :global(.project-page .og .p-list) {
    padding-left: 27px;
  }

  /* the two timer videos: on the wide layout the wrappers vanish (display: contents), the items keep their
     hand-placed positions. Stacked layouts: the videos stand side by side at their desktop size (112px). */
  .vid-pair,
  .vid-col {
    display: contents;
  }

  @media (max-width: 1260px) {
    .vid-pair {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 32px;
    }

    .vid-col {
      display: flex;
      flex-direction: column;
      gap: 31.7px;
    }

    .vid-col :global(.og) {
      width: auto;
      max-width: none;
    }

    .vid-col > :global(div.og) {
      width: 112px;
    }
  }
</style>
