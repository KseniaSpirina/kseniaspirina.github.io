---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="section-heading">
  <span class="rule"></span>
  <h2>{title}</h2>
</div>

<style>
  .section-heading {
    margin-bottom: 2.5rem;
  }

  .rule {
    display: block;
    width: 588px;
    max-width: 100%;
    height: 0;
    border-top: 4px solid #4361ee;
    margin-bottom: 1.5rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.25rem;
    color: #4361ee;
    text-transform: uppercase;
  }
</style>
