---
---

<div class="lightbox" data-lightbox-root hidden>
  <button class="lightbox-close" type="button" aria-label="Close">✕</button>
  <img class="lightbox-image" alt="" />
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(10, 10, 10, 0.92);
    cursor: zoom-out;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
    cursor: default;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #e8e8e8;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 150ms ease;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }
</style>

<script>
  function initLightbox() {
    const root = document.querySelector<HTMLDivElement>('[data-lightbox-root]');
    if (!root) return;
    const img = root.querySelector('img')!;
    const closeBtn = root.querySelector('.lightbox-close')!;

    function open(src: string, alt: string) {
      img.src = src;
      img.alt = alt;
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      root!.hidden = true;
      img.src = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach(el => {
      el.addEventListener('click', () => {
        const nestedImg = el.querySelector('img');
        const src = el.getAttribute('data-lightbox-src') || nestedImg?.currentSrc || nestedImg?.src || (el as HTMLImageElement).src;
        const alt = el.getAttribute('data-lightbox-alt') || nestedImg?.alt || (el as HTMLImageElement).alt || '';
        if (src) open(src, alt);
      });
    });

    root!.addEventListener('click', (e) => {
      if (e.target === root) close();
    });
    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root!.hidden) close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
