---
---

<div class="lightbox" data-lightbox-root hidden>
  <button class="lightbox-close" type="button" aria-label="Close">✕</button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous image">‹</button>
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Next image">›</button>
  <img class="lightbox-image" alt="" />
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(10, 10, 10, 0.92);
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
    cursor: default;
  }

  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #e8e8e8;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 150ms ease;
    z-index: 2;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .lightbox-nav {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    min-width: 3rem;
    border: none;
    background: transparent;
    color: #e8e8e8;
    font-size: 3rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    opacity: 0.5;
    transition: opacity 150ms ease, background 150ms ease;
  }

  .lightbox-nav:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.06);
  }

  .lightbox-prev {
    left: 0;
    justify-content: flex-start;
    padding-left: 1rem;
  }

  .lightbox-next {
    right: 0;
    justify-content: flex-end;
    padding-right: 1rem;
  }

  .lightbox-nav[hidden] {
    display: none;
  }
</style>

<script>
  function initLightbox() {
    const root = document.querySelector<HTMLDivElement>('[data-lightbox-root]');
    if (!root) return;
    const img = root.querySelector('img')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('.lightbox-close')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('.lightbox-prev')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.lightbox-next')!;

    let currentGroup: HTMLElement[] = [];
    let currentIndex = 0;

    function render() {
      const el = currentGroup[currentIndex];
      if (!el) return;
      const nestedImg = el.querySelector('img');
      const src = el.getAttribute('data-lightbox-src') || nestedImg?.currentSrc || nestedImg?.src || '';
      const alt = el.getAttribute('data-lightbox-alt') || nestedImg?.alt || '';
      img.src = src;
      img.alt = alt;
      const multi = currentGroup.length > 1;
      prevBtn.hidden = !multi;
      nextBtn.hidden = !multi;
    }

    function openAt(group: HTMLElement[], index: number) {
      currentGroup = group;
      currentIndex = index;
      render();
      root!.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      root!.hidden = true;
      img.src = '';
      document.body.style.overflow = '';
    }

    function step(delta: number) {
      if (currentGroup.length < 2) return;
      currentIndex = (currentIndex + delta + currentGroup.length) % currentGroup.length;
      render();
    }

    const allTriggers = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]'));

    allTriggers.forEach(el => {
      el.addEventListener('click', () => {
        const groupName = el.getAttribute('data-lightbox-group');
        const group = groupName
          ? allTriggers.filter(other => other.getAttribute('data-lightbox-group') === groupName)
          : [el];
        openAt(group, group.indexOf(el));
      });
    });

    root!.addEventListener('click', e => {
      if (e.target === root) close();
    });
    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    document.addEventListener('keydown', e => {
      if (root!.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
