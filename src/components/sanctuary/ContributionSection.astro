---
import LightboxImage from './LightboxImage.astro';
import SectionHeading from './SectionHeading.astro';
import g3 from '@assets/sanctuary/gallery/3.png';
import g4 from '@assets/sanctuary/gallery/4.png';
import g5 from '@assets/sanctuary/gallery/5.png';
import g6 from '@assets/sanctuary/gallery/6.png';
import g7 from '@assets/sanctuary/gallery/7.png';
import g8 from '@assets/sanctuary/gallery/8.png';
import g9 from '@assets/sanctuary/gallery/9.png';

// Verified layout from Figma (Page 2): row1 = 8,4,3,7 / row2 = 5,6,9
const row1 = [g8, g4, g3, g7];
const row2 = [g5, g6, g9];
---

<section class="contribution" id="contribution">
  <div class="grid-1440">
    <div class="full">
      <SectionHeading title="Contribution" />
    </div>

    <div class="span-4">
      <p class="label">My Role</p>
      <p class="body">
        World and visual language design. Character art, environment art, UI, full-screen
        illustrations. Animation. Contributed to worldbuilding, quest writing, and UX. Assembled and
        staged assets in-scene, handed off to programmers for integration and scripting.
      </p>
    </div>
    <div class="span-4">
      <p class="label">Challenge</p>
      <p class="body">
        Sole designer and artist on a 3-person team. Create a visual language for the project.
        Establish a full world identity: environment, characters, UI, animation, and illustration.
        Required a visual system that could clearly distinguish two groups within one cohesive world.
        Large creative scope to cover within a tight 3-month production timeline.
      </p>
    </div>

    <div class="full gallery-row">
      {row1.map((img, i) => (
        <div class="span-2">
          <LightboxImage src={img} alt={`Sanctuary gallery image ${i + 1}`} widths={[300, 560]} sizes="282px" />
        </div>
      ))}
    </div>
    <div class="full gallery-row">
      {row2.map((img, i) => (
        <div class="span-2">
          <LightboxImage src={img} alt={`Sanctuary gallery image ${i + 5}`} widths={[300, 560]} sizes="282px" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .contribution {
    padding: 4rem 0;
  }

  .grid-1440 {
    row-gap: 2.5rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  .span-4 {
    grid-column: span 4;
  }

  .span-2 {
    grid-column: span 2;
  }

  .gallery-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .span-4 {
      grid-column: span 4;
    }
    .gallery-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .span-4 {
      grid-column: 1 / -1;
    }
    .gallery-row {
      grid-template-columns: 1fr;
    }
  }

  .label {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #4361ee;
  }

  .body {
    margin: 0;
    color: #c9c9c9;
    line-height: 1.7;
  }

  .gallery-row :global(img) {
    width: 100%;
    aspect-ratio: 282 / 159;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
</style>
