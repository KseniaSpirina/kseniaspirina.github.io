---
import LightboxImage from './LightboxImage.astro';
import SectionHeading from './SectionHeading.astro';
import g3 from '@assets/sanctuary/gallery/3.png';
import g4 from '@assets/sanctuary/gallery/4.png';
import g5 from '@assets/sanctuary/gallery/5.png';
import g6 from '@assets/sanctuary/gallery/6.png';
import g7 from '@assets/sanctuary/gallery/7.png';
import g8 from '@assets/sanctuary/gallery/8.png';
import g9 from '@assets/sanctuary/gallery/9.png';

// Verified layout from Figma (Page 2): row1 = 8,4,3,7 / row2 = 5,6,9
const row1 = [g8, g4, g3, g7];
const row2 = [g5, g6, g9];
---

<section class="contribution" id="contribution">
  <div class="grid-1440">
    <div class="full">
      <SectionHeading title="Contribution" />
    </div>

    <div class="span-2">
      <p class="caption">Challenge</p>
      <ul class="running list">
        <li>Sole designer and artist on a 3-person team</li>
        <li>Create a visual language for the project</li>
        <li>Establish a full world identity: environment, characters, UI, animation, and illustration</li>
        <li>Required a visual system that could clearly distinguish two groups within one cohesive world</li>
        <li>Large creative scope to cover within a tight 3-month production timeline</li>
      </ul>
    </div>
    <div class="span-2 challenge">
      <p class="caption">My Role</p>
      <ul class="running list">
        <li>World&nbsp;and&nbsp;visual language design</li>
        <li>Character art, environment art, UI, full-screen illustrations</li>
        <li>Animation</li>
        <li>Contributed to worldbuilding, quest writing, and UX</li>
        <li>Assembled and staged assets in-scene, handed off to programmers for integration and scripting</li>
      </ul>
    </div>

    <div class="full gallery-row">
      {row1.map((img, i) => (
        <div class="span-2">
          <LightboxImage
            src={img}
            alt={`Sanctuary gallery image ${i + 1}`}
            widths={[400, 700, 1000, 1400, 1920]}
            sizes="(max-width: 640px) 95vw, (max-width: 1260px) 50vw, 588px"
            group="contribution-gallery"
          />
        </div>
      ))}
    </div>
    <div class="full gallery-row">
      {row2.map((img, i) => (
        <div class="span-2">
          <LightboxImage
            src={img}
            alt={`Sanctuary gallery image ${i + 5}`}
            widths={[400, 700, 1000, 1400, 1920]}
            sizes="(max-width: 640px) 95vw, (max-width: 1260px) 50vw, 588px"
            group="contribution-gallery"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .contribution {
    padding: 4rem 0;
  }

  .grid-1440 {
    row-gap: 0;
  }

  /* heading -> content 64, content -> gallery 96, gallery rows 24 apart */
  .full:has(:global(.section-heading)) {
    margin-bottom: 0;
  }

  .gallery-row {
    margin-top: 24px;
  }

  .span-2 + .span-2 + .gallery-row,
  .challenge + .gallery-row {
    margin-top: 96px;
  }

  .full {
    grid-column: 1 / -1;
  }

  .span-4 {
    grid-column: span 4;
  }

  .span-2 {
    grid-column: span 2;
  }

  .challenge {
    grid-column: 5 / span 2;
  }

  @media (max-width: 1260px) {
    .challenge {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .challenge {
      grid-column: 1 / -1;
      /* stacked under the first list: 64px between the two blocks */
      margin-top: 64px;
    }
  }

  .gallery-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1260px) {
    .span-4 {
      grid-column: span 4;
    }
    .gallery-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-row .span-2 {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .span-4 {
      grid-column: 1 / -1;
    }
    .gallery-row {
      grid-template-columns: 1fr;
    }
    .gallery-row .span-2 {
      grid-column: 1 / -1;
    }
  }

  .caption {
    margin: 0 0 32px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    color: #e8e8e8;
  }

  .running {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    color: #d6d6d6;
    line-height: 1.5;
  }

  .running.list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .gallery-row :global(img) {
    width: 100%;
    aspect-ratio: 282 / 159;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
</style>
