---
import LightboxImage from './LightboxImage.astro';
import SectionHeading from './SectionHeading.astro';
import { Image } from 'astro:assets';

import engineerArin from '@assets/sanctuary/characters/character.png';
import builderRovan from '@assets/sanctuary/characters/character6.png';
import collectorMiren from '@assets/sanctuary/characters/character3.png';
import elderThalin from '@assets/sanctuary/characters/character4.png';
import mainCharacterSheet from '@assets/sanctuary/characters/character5.png';
import allCharacters from '@assets/sanctuary/characters/all-characters-together.png';
import referencesTogether from '@assets/sanctuary/characters/references-together.png';
import silhouettes from '@assets/sanctuary/characters/silhoettes.png';
import finalSketch from '@assets/sanctuary/characters/final-sketch-web.jpg';
import finalLine from '@assets/sanctuary/characters/final-line.png';
import mcColorVariation from '@assets/sanctuary/characters/mc-color-variation.png';
import mcFinal from '@assets/sanctuary/characters/mc-final-design.jpg';
---

<section class="character-design" id="character-design">
  <div class="grid-1440">
    <div class="full">
      <SectionHeading title="Character Design" />
    </div>

    <div class="full banner">
      <Image src={allCharacters} alt="All Sanctuary characters together" widths={[600, 1200, 1800]} sizes="100vw" loading="lazy" />
    </div>

    <div class="full">
      <p class="caption">Character Design Approach</p>
    </div>
    <p class="running narrow">
      The core challenge was designing three distinct character identities: two settlement groups
      shaped by different values, and an outsider protagonist. Each needed to read as clearly
      different at a glance. At the same time, all three had to feel like they belong to the same
      visual world.
    </p>

    <div class="full">
      <p class="caption">Mind Group</p>
    </div>
    <div class="row">
      <div class="col-3">
        <LightboxImage src={engineerArin} alt="Engineer Arin — Mind group character sheet" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />
      </div>
      <div class="col-3">
        <LightboxImage src={builderRovan} alt="Builder Rovan — Mind group character sheet" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />
      </div>
      <div class="col-2">
        <ul class="running list">
          <li>Cold blue palette, sharp geometric forms</li>
          <li>Functional, tech-driven design.</li>
          <li>Materials: metal, polymers, plastic</li>
          <li>Defining trait: a head suspended by a thick cable</li>
        </ul>
      </div>
    </div>

    <div class="full">
      <p class="caption">Spirit Group</p>
    </div>
    <div class="row">
      <div class="col-3">
        <LightboxImage src={collectorMiren} alt="Collector Miren — Spirit group character sheet" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />
      </div>
      <div class="col-3">
        <LightboxImage src={elderThalin} alt="Elder Thalin — Spirit group character sheet" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />
      </div>
      <div class="col-2">
        <ul class="running list">
          <li>Warm, natural palette with purple accents that intensify with status</li>
          <li>Rounded, organic forms with growing ornamentation by rank</li>
          <li>Natural materials: fabric, wood, occasional tech elements tied to profession</li>
        </ul>
      </div>
    </div>

    <div class="full">
      <p class="caption">Main Character</p>
    </div>
    <div class="row">
      <div class="col-3">
        <LightboxImage src={mainCharacterSheet} alt="Main character sheet" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />
      </div>
      <div class="col-2">
        <ul class="running list">
          <li>Unique palette and materials, unused by either group</li>
          <li>Visually marks them as an outsider arriving from beyond the settlement</li>
        </ul>
      </div>
    </div>

    <div class="full">
      <p class="process-heading">Process Breakdown</p>
    </div>

    <div class="full pb-grid">
      <div class="pb-c1-2">
        <p class="caption small">References</p>
        <Image src={referencesTogether} alt="Character references" widths={[300, 560]} sizes="282px" loading="lazy" style="aspect-ratio: 282/256;" />
        <p class="running quote">When I need to design something unusual, I like to rely on nature.</p>
      </div>
      <div class="pb-c4-4">
        <p class="caption small">Silhouette Search</p>
        <Image src={silhouettes} alt="Silhouette exploration" widths={[600, 1176]} sizes="588px" loading="lazy" style="aspect-ratio: 588/284;" />
      </div>

      <div class="pb-c1-2">
        <p class="caption small">Final Sketch</p>
        <Image src={finalSketch} alt="Final sketch" widths={[300, 560]} sizes="282px" loading="lazy" style="aspect-ratio: 282/453;" />
      </div>
      <div class="pb-c6-3">
        <p class="caption small">Final Line</p>
        <Image src={finalLine} alt="Final line art" widths={[400, 834]} sizes="417px" loading="lazy" style="aspect-ratio: 417/453;" />
      </div>

      <div class="pb-c1-3">
        <p class="caption small">Color Search</p>
        <Image src={mcColorVariation} alt="Color variation exploration" widths={[400, 872]} sizes="436px" loading="lazy" style="aspect-ratio: 436/316;" />
      </div>
      <div class="pb-c5-4">
        <p class="caption small">Final</p>
        <Image src={mcFinal} alt="Main character final design" widths={[600, 1176]} sizes="588px" loading="lazy" style="aspect-ratio: 588/379;" />
      </div>
    </div>
  </div>
</section>

<style>
  .character-design {
    padding: 4rem 0;
  }

  .grid-1440 {
    row-gap: 2.5rem;
  }

  .full {
    grid-column: 1 / -1;
  }

  .banner :global(img) {
    width: 100%;
    border-radius: 4px;
    display: block;
  }

  .caption {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    color: #e8e8e8;
    margin: 0 0 0.75rem;
  }

  .caption.small {
    margin: 0 0 0.5rem;
  }

  .process-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: #e8e8e8;
    margin: 0;
  }

  .running {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    color: #c9c9c9;
    line-height: 1.7;
    margin: 0;
  }

  .running.narrow {
    grid-column: span 3;
    max-width: 100%;
  }

  .running.quote {
    margin-top: 0.75rem;
  }

  .running.list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* --- Mind / Spirit / Main Character rows --- */
  .row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 24px;
    align-items: start;
  }

  .col-2 {
    grid-column: span 2;
  }

  .col-3 {
    grid-column: span 3;
  }

  .col-2 :global(img),
  .col-3 :global(img) {
    width: 100%;
    border-radius: 4px;
    display: block;
  }

  @media (max-width: 1024px) {
    .row {
      grid-template-columns: repeat(4, 1fr);
    }
    .col-2,
    .col-3 {
      grid-column: span 2;
    }
    .running.narrow {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .col-2,
    .col-3 {
      grid-column: 1 / -1;
    }
  }

  /* --- Process Breakdown --- */
  .pb-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 24px;
  }

  .pb-c1-2 {
    grid-column: 1 / span 2;
  }

  .pb-c1-3 {
    grid-column: 1 / span 3;
  }

  .pb-c4-4 {
    grid-column: 4 / span 4;
  }

  .pb-c5-4 {
    grid-column: 5 / span 4;
  }

  .pb-c6-3 {
    grid-column: 6 / span 3;
  }

  .pb-grid :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  @media (max-width: 1024px) {
    .pb-c1-2,
    .pb-c1-3 {
      grid-column: 1 / span 4;
    }
    .pb-c4-4,
    .pb-c5-4,
    .pb-c6-3 {
      grid-column: 5 / span 4;
    }
  }

  @media (max-width: 640px) {
    .pb-grid {
      grid-template-columns: 1fr;
    }
    .pb-c1-2,
    .pb-c1-3,
    .pb-c4-4,
    .pb-c5-4,
    .pb-c6-3 {
      grid-column: 1 / -1;
    }
  }
</style>
