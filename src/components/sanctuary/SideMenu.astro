---
interface Link {
  label: string;
  href: string;
}

interface Props {
  links?: Link[];
}

const {
  links = [
    { label: 'OVERVIEW', href: '#top' },
    { label: 'CONTRIBUTION', href: '#contribution' },
    { label: 'CHARACTER DESIGN', href: '#character-design' },
    { label: 'ANIMATION', href: '#animation' },
    { label: 'ENVIRONMENT DESIGN', href: '#environment-design' },
    { label: 'UI DESIGN', href: '#ui-design' },
    { label: 'CONTACT', href: '#contact' },
  ],
} = Astro.props;
---

<button class="menu-icon" type="button" data-menu-toggle aria-label="Toggle contents menu" aria-expanded="false">
  <span></span>
  <span></span>
  <span></span>
</button>

<span class="sentinel" data-menu-sentinel></span>

<nav class="side-menu" data-side-menu aria-label="Page contents">
  <p class="side-menu-title">CONTENTS</p>
  <ul>
    {links.map(link => (
      <li>
        <a href={link.href} data-menu-link>{link.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .menu-icon {
    position: fixed;
    top: var(--menu-align-top, 19.7rem);
    right: 2.7rem;
    z-index: 210;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-icon span {
    display: block;
    width: 1.5rem;
    height: 2px;
    background: #e8e8e8;
    transition: background 150ms ease;
  }

  @media (hover: hover) {
    .menu-icon:hover span {
      background: #4361ee;
  }
  }

  .side-menu {
    position: fixed;
    top: var(--menu-align-top, 12.7rem);
    right: 7.5rem;
    z-index: 200;
    width: 282px;
    padding: 24px 24px 52px 27px;
    background: #121212;
    border-radius: 4px;
    transform-origin: top center;
    transition: transform 400ms ease, opacity 300ms ease;
  }

  .side-menu.is-collapsed {
    transform: scaleY(0);
    opacity: 0;
    pointer-events: none;
  }

  .side-menu.is-open-forced {
    transform: scaleY(1);
    opacity: 1;
    pointer-events: auto;
  }

  .side-menu-title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 40px;
    font-weight: 700;
    color: #4361ee;
  }

  .side-menu ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 5px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .side-menu a {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
    /* a name of two lines: the lines stand closer (22px) than the items (the single-line item is still 32px high:
       22px + 5px above and under, so the distance between the items has not changed) */
    line-height: 22px;
    padding: 5px 0;
    color: #e8e8e8;
    text-decoration: none;
    transition: color 150ms ease;
  }

  @media (hover: hover) {
    .side-menu a:hover {
      color: #4361ee;
  }
  }

  @media (max-width: 1260px) {
    .menu-icon {
      display: none;
    }

    .side-menu,
    .side-menu.is-collapsed,
    .side-menu.is-open-forced {
      position: static;
      grid-column: 1 / -1;
      order: 10;
      width: auto;
      margin-top: 72px;
      padding: 0;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .side-menu ul {
      padding-left: 0;
    }
  }
</style>

<script>
  function initSideMenu() {
    const menu = document.querySelector<HTMLElement>('[data-side-menu]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const sentinel = document.querySelector<HTMLElement>('[data-menu-sentinel]');
    if (!menu || !toggle || !sentinel) return;

    let collapsedByScroll = false;
    let forcedOpen = false;

    function render() {
      menu!.classList.toggle('is-collapsed', collapsedByScroll && !forcedOpen);
      menu!.classList.toggle('is-open-forced', forcedOpen);
      toggle!.setAttribute('aria-expanded', String(collapsedByScroll ? forcedOpen : true));
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        collapsedByScroll = !entry.isIntersecting;
        if (collapsedByScroll === false) forcedOpen = false;
        render();
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);

    toggle.addEventListener('click', () => {
      forcedOpen = !forcedOpen;
      render();
    });

    menu.querySelectorAll('[data-menu-link]').forEach(link => {
      link.addEventListener('click', () => {
        forcedOpen = true;
        render();
      });
    });

    render();
  }

  function alignToTrailer() {
    const trailer = document.querySelector<HTMLElement>('.trailer');
    if (!trailer) return;
    const docTop = trailer.getBoundingClientRect().top + window.scrollY;
    document.documentElement.style.setProperty('--menu-align-top', `${docTop}px`);
  }

  function initMenuAlign() {
    alignToTrailer();
    window.addEventListener('resize', alignToTrailer);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuAlign);
  } else {
    initMenuAlign();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSideMenu);
  } else {
    initSideMenu();
  }
</script>
