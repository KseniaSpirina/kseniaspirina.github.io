---
interface Props {
  prevHref?: string;
  nextHref?: string;
}

const { prevHref, nextHref } = Astro.props;
---

{prevHref && (
  <a class="nav-arrow nav-arrow-prev" href={prevHref} aria-label="Previous project">
    <svg width="40" height="80" viewBox="0 0 40 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M32 4 L8 40 L32 76" stroke="currentColor" stroke-width="2" />
    </svg>
    <span class="label">Previous project</span>
  </a>
)}

{nextHref && (
  <a class="nav-arrow nav-arrow-next" href={nextHref} aria-label="Next project">
    <svg width="40" height="80" viewBox="0 0 40 80" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 4 L32 40 L8 76" stroke="currentColor" stroke-width="2" />
    </svg>
    <span class="label">Next project</span>
  </a>
)}

<style>
  .nav-arrow {
    position: fixed;
    top: 39.4rem;
    z-index: 210;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #9a9a9a;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav-arrow:hover {
    color: #e8e8e8;
  }

  .nav-arrow-prev {
    left: 2.4rem;
  }

  .nav-arrow-next {
    right: 2.7rem;
  }

  .label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
  }

  @media (max-width: 1260px) {
    .nav-arrow {
      display: none;
    }
  }
</style>
