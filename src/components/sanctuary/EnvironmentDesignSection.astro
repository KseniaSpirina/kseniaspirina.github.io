---
import LightboxImage from './LightboxImage.astro';
import SectionHeading from './SectionHeading.astro';
import { Image } from 'astro:assets';

import hallFinal from '@assets/sanctuary/environment/hall-final.png';
import archiveColor from '@assets/sanctuary/environment/archive-color-1.png';
import galleryOfGoblets from '@assets/sanctuary/environment/gallery-2.png';
import laboratory from '@assets/sanctuary/environment/fixing-room-all-together.png';
import enteringRoom from '@assets/sanctuary/environment/tutorial-room-for-unity-1.png';
import sketches from '@assets/sanctuary/environment/sketches-environment-1.jpg';
import blockout from '@assets/sanctuary/environment/fixing-room-3d-blockout.jpg';
import lineArt from '@assets/sanctuary/environment/fixing-room-line.jpg';
import references from '@assets/sanctuary/environment/references-environment.png';
import finalColorRender from '@assets/sanctuary/environment/fixing-room-all-together.png';
---

<section class="environment-design grid-1440" id="environment-design">
  <SectionHeading title="Environment Design" />
  <p class="caption">Environment Design Approach</p>

  <p class="running narrow">
    Environment design faces the same core challenge as character design: dividing space stylistically
    between the two factions, while resolving how those two spaces meet and collide. The central theme
    is coexistence with nature versus its conquest and transformation.
  </p>

  <p class="caption">Hall</p>
  <div class="row">
    <div class="c3-2">
      <ul class="running list">
        <li>The heart of the Sanctuary, where Mind and Spirit styles blend and bleed into one another</li>
      </ul>
    </div>
    <div class="c5-2">
      <ul class="running list">
        <li>Right side leans toward Spirit, left side toward Mind — the center of the hall is designed like an altar, underscoring its significance to the Sanctuary as a whole</li>
      </ul>
    </div>
  </div>
  <div class="full media">
    <LightboxImage src={hallFinal} alt="Hall of the Sanctuary" widths={[600, 1200, 1800]} sizes="100vw" />
  </div>

  <p class="caption accent">Rooms · Spirit</p>
  <div class="row">
    <div class="c3-2">
      <ul class="running list">
        <li>Made in synergy with nature</li>
        <li>Walls and columns left largely unworked stone</li>
        <li>Decorated with carved ornaments and drawings referencing ancient civilizations</li>
      </ul>
    </div>
    <div class="c5-2">
      <ul class="running list">
        <li>Warm palette, softly lit by candlelight</li>
        <li>Materials: stone, wood, glass</li>
      </ul>
    </div>
  </div>

  <p class="caption">Archive</p>
  <div class="full media">
    <LightboxImage src={archiveColor} alt="Archive room" widths={[600, 1200, 1800]} sizes="100vw" />
  </div>

  <p class="caption">Hall of Goblets</p>
  <div class="full media">
    <LightboxImage src={galleryOfGoblets} alt="Hall of Goblets" widths={[600, 1200, 1800]} sizes="100vw" />
  </div>

  <p class="caption accent">Rooms · Mind</p>
  <div class="row">
    <div class="c3-2">
      <ul class="running list">
        <li>Nature is absent</li>
        <li>Inspired by laboratories and manufacturing facilities</li>
        <li>Filled with machinery and futuristic technology</li>
      </ul>
    </div>
    <div class="c5-2">
      <ul class="running list">
        <li>Cold blue-green palette, creating an alienating, uncomfortable atmosphere</li>
        <li>Materials: concrete, metal, tile, glass</li>
      </ul>
    </div>
  </div>

  <p class="caption">Laboratory</p>
  <div class="c2-6 media">
    <LightboxImage src={laboratory} alt="Laboratory room" widths={[500, 900, 1400]} sizes="(max-width: 768px) 100vw, 892px" />
  </div>

  <p class="caption">Sanctuary Entering Room</p>
  <div class="c2-6 media">
    <LightboxImage src={enteringRoom} alt="Sanctuary entering room" widths={[500, 900, 1400]} sizes="(max-width: 768px) 100vw, 892px" />
  </div>

  <p class="process-heading">Process Breakdown</p>

  <div class="c1-2">
    <p class="caption small">References</p>
    <Image src={references} alt="Environment references" widths={[300, 560]} sizes="282px" loading="lazy" />
  </div>
  <div class="c5-4">
    <p class="caption small">Sketches</p>
    <Image src={sketches} alt="Environment sketches" widths={[600, 1176]} sizes="588px" loading="lazy" />
  </div>

  <div class="c1-3">
    <p class="caption small">3D Blockout</p>
    <Image src={blockout} alt="3D blockout" widths={[400, 870]} sizes="435px" loading="lazy" />
  </div>
  <div class="c5-3">
    <p class="caption small">Final Line</p>
    <Image src={lineArt} alt="Final line art" widths={[400, 870]} sizes="435px" loading="lazy" />
  </div>

  <div class="c1-3">
    <p class="caption small">Final Color and Render</p>
    <Image src={finalColorRender} alt="Final color and render" widths={[400, 870]} sizes="435px" loading="lazy" />
  </div>
</section>

<style>
  .environment-design {
    padding: 4rem 0;
    row-gap: 2.5rem;
  }

  .environment-design > :global(*) {
    grid-column: 1 / -1;
  }

  .full {
    grid-column: 1 / -1;
  }

  .row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 24px;
  }

  .c3-2 {
    grid-column: 3 / span 2;
  }

  .c5-2 {
    grid-column: 5 / span 2;
  }

  .c1-2 {
    grid-column: 1 / span 2;
  }

  .c1-3 {
    grid-column: 1 / span 3;
  }

  .c5-3 {
    grid-column: 5 / span 3;
  }

  .c5-4 {
    grid-column: 5 / span 4;
  }

  .c2-6 {
    grid-column: 2 / span 6;
  }

  @media (max-width: 1024px) {
    .c3-2,
    .c5-2,
    .c1-2,
    .c1-3,
    .c5-3,
    .c5-4 {
      grid-column: span 4;
    }
    .c2-6 {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .c3-2,
    .c5-2,
    .c1-2,
    .c1-3,
    .c5-3,
    .c5-4 {
      grid-column: 1 / -1;
    }
  }

  .caption {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.125rem;
    text-transform: uppercase;
    color: #e8e8e8;
    margin: 0 0 0.75rem;
  }

  .caption.small {
    margin: 0 0 0.5rem;
  }

  .caption.accent {
    color: #4361ee;
  }

  .process-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    color: #e8e8e8;
    margin: 0;
  }

  .running {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    color: #c9c9c9;
    line-height: 1.7;
    margin: 0;
  }

  .running.narrow {
    grid-column: span 3;
  }

  .running.list {
    list-style: disc;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (max-width: 1024px) {
    .running.narrow {
      grid-column: 1 / -1;
    }
  }

  .media :global(img),
  .c1-2 :global(img),
  .c1-3 :global(img),
  .c5-3 :global(img),
  .c5-4 :global(img) {
    width: 100%;
    border-radius: 4px;
    display: block;
  }
</style>
