---
interface Props {
  prevHref?: string;
  nextHref?: string;
  /** link texts (default: "Previous project" / "Next project"; Skills pages name the skill) */
  prevLabel?: string;
  nextLabel?: string;
  ariaLabel?: string;
}

const { prevHref, nextHref, prevLabel = 'Previous project', nextLabel = 'Next project', ariaLabel = 'Projects' } = Astro.props;
---

<nav class="pager grid-1440" aria-label={ariaLabel}>
  <div class="inner">
    {prevHref ? <a class="prev" href={prevHref}>&larr; {prevLabel}</a> : <span></span>}
    {nextHref ? <a class="next" href={nextHref}>{nextLabel} &rarr;</a> : <span></span>}
  </div>
</nav>

<style>
  .pager {
    display: none;
    padding-bottom: 96px;
  }

  .inner {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  a {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
    line-height: 32px;
    text-transform: uppercase;
    color: #9a9a9a;
    text-decoration: none;
    transition: color 150ms ease;
  }

  @media (hover: hover) {
    a:hover {
      color: #e8e8e8;
  }
  }

  @media (max-width: 1260px) {
    .pager {
      display: grid;
    }
  }
</style>
