---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  group?: string;
  caption?: string;
}

const {
  src,
  alt,
  widths = [500, 900, 1400],
  sizes = '(max-width: 768px) 100vw, 50vw',
  class: className,
  group,
  caption,
} = Astro.props;

const full = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp', quality: 82 });
---

<button
  type="button"
  class:list={['lightbox-figure', className]}
  data-lightbox
  data-lightbox-alt={alt}
  data-lightbox-src={full.src}
  data-lightbox-group={group}
  data-lightbox-caption={caption}
>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" quality={90} />
</button>

<style>
  .lightbox-figure {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 4px;
  }

  .lightbox-figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .lightbox-figure:hover :global(img) {
    transform: scale(1.03);
  }
</style>
