---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const { src, alt, widths = [500, 900, 1400], sizes = '(max-width: 768px) 100vw, 50vw', class: className } = Astro.props;
---

<button type="button" class:list={['lightbox-figure', className]} data-lightbox data-lightbox-alt={alt}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" data-lightbox-full />
</button>

<style>
  .lightbox-figure {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 4px;
  }

  .lightbox-figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .lightbox-figure:hover :global(img) {
    transform: scale(1.03);
  }
</style>
