---
import BaseLayout from '@layouts/BaseLayout.astro';
import '../../styles/grid.css';
import '../../styles/project.css';
import '../../styles/sanctuary-text.css';
import Lightbox from '../sanctuary/Lightbox.astro';
import ContactSection from '../project/ContactSection.astro';
import ProjectNavArrows from '../sanctuary/ProjectNavArrows.astro';
import ProjectPager from '../sanctuary/ProjectPager.astro';
import SideMenu from '../sanctuary/SideMenu.astro';
import { skillPages } from '../../config/skills';

interface Props {
  /** page heading and <title>, e.g. "Environment Design" */
  title: string;
  description: string;
  /** slug of this skill: the previous / next arrows are taken from the order in config/skills.ts.
   *  Without it (the "Other projects" page) the page has no arrows. */
  slug?: string;
  /** explicit arrows (the "Other projects" page links to the previous project instead of a skill) */
  prevHref?: string;
  prevLabel?: string;
  /** the "Contents" menu of a project page (OVERVIEW and CONTACT are added): one link per section.
   *  The content under the title goes in the "hero" slot, in the place of a trailer. */
  menu?: { label: string; href: string }[];
}

const { title, description, slug, prevHref: ownPrevHref, prevLabel: ownPrevLabel, menu } = Astro.props;

// The first page has no "previous" arrow and the last page has no "next" arrow.
const index = slug ? skillPages.findIndex((skill) => skill.slug === slug) : -1;
const prev = index >= 0 ? skillPages[index - 1] : undefined;
const next = index >= 0 ? skillPages[index + 1] : undefined;
const prevHref = ownPrevHref ?? (prev ? `/skills/${prev.slug}` : undefined);
const prevLabel = ownPrevLabel ?? prev?.title;
const nextHref = next ? `/skills/${next.slug}` : undefined;
const nextLabel = next?.title;
---

<!-- A Skills detail page: the heading, then the same section of several projects one after another, then Contact.
     Put every Sanctuary section inside <div class="sanctuary"> (its text styles need that wrapper). -->
<BaseLayout title={`${title} — Ksenia Spirina`} {description}>
  <div class="skill-page project-page text-v2">
    <ProjectNavArrows {prevHref} {nextHref} {prevLabel} {nextLabel} />

    <section class:list={['skill-hero', 'grid-1440', { 'has-menu': menu }]} id={menu ? 'top' : undefined}>
      {menu && <SideMenu links={[{ label: 'OVERVIEW', href: '#top' }, ...menu, { label: 'CONTACT', href: '#contact' }]} />}
      <h1 class="skill-title">{title}</h1>
      <slot name="hero" />
    </section>

    <div class="skill-body">
      <slot />
      <ContactSection />
    </div>

    <ProjectPager {prevHref} {nextHref} {prevLabel} {nextLabel} ariaLabel="Skills" />

    <Lightbox />
  </div>
</BaseLayout>

<style>
  .skill-page {
    background: #121212;
    color: #e8e8e8;
  }

  .skill-hero {
    padding-top: calc(128px - var(--nav-height));
    /* page title -> first section: 64px */
    padding-bottom: 64px;
  }

  .skill-hero > :global(*) {
    grid-column: 1 / -1;
  }

  /* with the Contents menu the top is as on a project page: the content under the title in the place of the
     trailer (64px under the title), 128px to the first section */
  .skill-hero.has-menu {
    position: relative;
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  /* Sanctuary sections bring their own 64px above and below: here sections are 128px apart, like on the project pages */
  :global(.skill-page .sanctuary > section) {
    padding-top: 0;
    padding-bottom: 128px;
  }

  /* project description + credits right under the project name: in the Sanctuary sections it spans the whole grid,
     and the content that follows it needs its 96px (those sections do not add the gap themselves) */
  :global(.skill-page .sanctuary .skill-intro) {
    grid-column: 1 / -1;
  }

  :global(.skill-page .sanctuary :is(.character-design, .ui-design, .animation) .skill-intro) {
    margin-bottom: 96px;
  }

  /* Contact (the last section) -> footer: 128px (the footer has its own 128px margin) */
  :global(.skill-body > #contact) {
    padding-bottom: 0;
  }

  /* the "previous / next" row (shown below 1260px, where the side arrows are hidden): 128px under Contact and
     128px (the footer's margin) above the footer */
  :global(.skill-page nav.pager) {
    margin-top: 128px;
    padding-bottom: 0;
  }

  /* Unbounded: the line box starts 128px from the top of the page, the empty space below the capitals is trimmed */
  .skill-title {
    display: flow-root;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .skill-title::after {
    content: '';
    display: block;
    height: 0;
    margin-bottom: -0.25em;
  }
</style>

<style is:global>
  body:has(.skill-page) {
    background-color: #121212;
  }

  body:has(.skill-page) .navbar {
    background-color: #121212;
    backdrop-filter: none;
    border-bottom-color: #121212;
  }

  body:has(.skill-page) .footer {
    background-color: #121212;
    border-top-color: #121212;
  }
</style>
