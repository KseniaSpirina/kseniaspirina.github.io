---
import SanctuaryCredits from '../credits/SanctuaryCredits.astro';
import ImprisonedCredits from '../credits/ImprisonedCredits.astro';
import MournCredits from '../credits/MournCredits.astro';
import StellarStraysCredits from '../credits/StellarStraysCredits.astro';
import DepartureCredits from '../credits/DepartureCredits.astro';

type ProjectKey = 'sanctuary' | 'imprisoned' | 'mourn' | 'stellar-strays' | 'departure';

type SkillKey = 'character-design' | 'environment-design' | 'animation' | 'ui-design';

interface Props {
  project: ProjectKey;
  /** the skill page this section stands on: it gives the "MY ROLE IN ..." subhead and text */
  skill: SkillKey;
}

const { project, skill } = Astro.props;

const skillNames: Record<SkillKey, string> = {
  'character-design': 'character design',
  'environment-design': 'environment design',
  animation: 'animation',
  'ui-design': 'UI design',
};

// "My role" texts: what I did on each project, for each skill.
const roles: Record<SkillKey, Partial<Record<ProjectKey, string>>> = {
  animation: {
    sanctuary: '2D animation, rigging (Spine 2D), animator setup (Unity)',
    'stellar-strays': '2D animation, rigging (Spine 2D)',
    departure: '2D animation, rigging (Spine 2D), animator setup (Unity), visual scripting (Unity)',
  },
  'character-design': {
    sanctuary: 'Visual style development, character design',
    mourn: 'Visual style development, character design',
    'stellar-strays': 'Visual style development (with Maayan Berkovits), character design (Fermi character)',
    departure: 'Visual style development, character design',
  },
  'environment-design': {
    sanctuary: 'Visual style development, environment design and art, asset preparation and integration (Unity)',
    imprisoned:
      'Visual style development and materials (with Ohad Lerman), environment design (3 levels, solo), 3D asset design and modeling (Cinema 4D), shaders (Shader Graph), asset integration (Unity)',
    mourn: 'Visual style development, environment design and art, asset preparation and integration (Unity)',
    departure: 'Visual style development, environment design and art, asset preparation and integration (Unity)',
  },
  'ui-design': {
    sanctuary: 'UI style development, UI design, UI animation, animator setup (Unity)',
    imprisoned: 'UI style development, UI animation (with programmers), UI shaders (Shader Graph), UI asset integration (Unity)',
    mourn: 'UI style development, UI design, UI animation, animator setup (Unity), visual scripting (Unity)',
  },
};
const role = roles[skill][project];

// Short project descriptions for the Skills pages; credits are the same components that the project pages use.
const descriptions: Record<ProjectKey, string[]> = {
  sanctuary: [
    'A narrative sci-fi game set in a post-apocalyptic world, where survival depends on coexisting with mysterious water beings. As an outsider seeking a place in one of the last safe settlements, the player earns the residents’ trust through open-ended conversations powered by an LLM dialogue system.',
  ],
  imprisoned: [
    'A top-down action game about a newborn slime on a mission to free its creator. Every move leaves a deadly trail that destroys enemies, but it also drains the slime’s own body, so movement is both its weapon and its life.',
  ],
  mourn: [
    'A short narrative game about grief, memory, and the regrets that remain after a sudden loss. Through conversation and choice, the player relives a single day and finds the strength to face the pain.',
    '<strong>Content warning:</strong> themes of grief and trauma, including a fatal accident.',
  ],
  'stellar-strays': [
    'A local co-op platformer for two players. Astronaut Fermi and repair-bot Rumba crash-land on an alien planet and must work together to recover their scattered ship parts, each of which only one of them can safely collect.',
  ],
  departure: [
    'A game animation project that combines a 2D character with a stylized 3D environment. A gentle giant, shy by nature yet remarkably strong, moves through mysterious caverns with a full set of Spine 2D animations, playable in Unity.',
  ],
};

const credits = {
  sanctuary: SanctuaryCredits,
  imprisoned: ImprisonedCredits,
  mourn: MournCredits,
  'stellar-strays': StellarStraysCredits,
  departure: DepartureCredits,
};
const Credits = credits[project];
---

<!-- Project description (3 columns) and Credits (3 columns, one column gap) right under the project name and its grey line.
     Same layout as the top of a project page. -->
<div class="block skill-intro">
  <div class="cols">
    <div class="gc-1-3">
      <h3 class="p-label">Project description</h3>
      <div class="after-label">
        {descriptions[project].map((paragraph) => <p class="p-text" set:html={paragraph} />)}
      </div>
      {role && (
        <>
          <h3 class="p-label role-label">My role in {skillNames[skill]}</h3>
          <p class="p-text after-label">{role}</p>
        </>
      )}
    </div>
    <div class="gc-5-3">
      <h3 class="p-label">Credits</h3>
      <div class="after-label">
        <Credits cls="p-text" />
      </div>
    </div>
  </div>
</div>

<style>
  /* description -> "MY ROLE IN ..." 96px (block to block) */
  .role-label {
    margin-top: 96px;
  }
</style>
