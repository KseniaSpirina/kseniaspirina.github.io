---
import ProjectSection from '../imprisoned/ProjectSection.astro';

const challenge = [
  'Develop assets that can be combined modularly to fill large level spaces',
  'Show the character of Fermi through animation',
  'Develop a visual style that creates an alien feeling',
  'Establish clear visual rules that tell the player what is dangerous, what the characters can interact with, and which character can interact with which objects',
];

const role = [
  'Developed the shared visual language of the game together with Maayan Berkovits',
  'Design and animation of Fermi, one of the two main characters',
  'Design of the world assets',
  'Design of interactive objects together with Maayan Berkovits',
  'Design of the itch.io page',
];

---

<ProjectSection id="contribution" title="Contribution">
  <div class="cols">
    <div class="gc-1-2">
      <h3 class="p-label">Challenge</h3>
      <ul class="p-list hang loose after-label">
        {challenge.map(item => <li>{item}</li>)}
      </ul>
    </div>
    <div class="gc-5-2">
      <h3 class="p-label">My role</h3>
      <ul class="p-list hang loose after-label">
        {role.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</ProjectSection>
