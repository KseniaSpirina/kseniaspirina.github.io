---
import { Image } from 'astro:assets';
import ProjectSection from '../imprisoned/ProjectSection.astro';

import earlier from '@assets/departure/earlier-character.jpg';
import firstDesign from '@assets/departure/first-design.jpg';
import finalDesign from '@assets/departure/final-design.jpg';

const kept = [
  'Sense of imposing physical strength',
  'Massive arms, tail, and long, flowing braids on the head',
  'Humanoid upper body',
  'Color accent on the arms',
  'Pink and purple palette',
];

const leftBehind = [
  'Childlike playfulness of the original personality',
  'Heavy silhouette detailing on the tail',
  'More human-like face',
];

const draft = [
  [
    'New visual style: clean, flat colors paired with lineart that strengthens the separation from the background, so the character stays readable in any scene',
    'Muted purple base color, which gives the character a more melancholic mood and helps her blend into the underground setting',
  ],
  [
    'Bright, saturated accents on the arms, which make them a key focal point and keep the character’s movement easy to track',
    'The same accents also plan ahead for arm-based attacks, so future combat moves stay clearly readable',
  ],
  [
    'Simplified tail shape',
    'More stylized face, also marked with bright accents',
    'Braids kept from the original concept, now used to carry the quest item',
  ],
];

const final = [
  'Cleaner, more dynamic silhouette',
  'Unnecessary details removed from both the form and the coloring',
  'Reworked proportions that make the character feel smaller yet powerful',
  'Braids replaced with a single flexible head tail, for a cleaner shape and easier animation',
  'A more mysterious, otherworldly presence overall',
];

const draftCols = ['gc-1-2', 'gc-4-2', 'gc-7-2'];
---

<ProjectSection id="character-design" title="Character design">
  <div class="block">
    <div class="cols">
      <div class="gc-1-3">
        <h3 class="p-label">Character design approach</h3>
        <p class="p-text after-label">
          For this project, I revisited one of my earlier characters and reworked the concept. I
          kept her distinctive physical traits as the foundation, partly reshaped her personality,
          and grounded her in a new environment: life underground. I also redesigned the form with
          gameplay in mind. To make the character read clearly on screen, I stripped away much of
          the detail and simplified several elements, which also made it easier to animate.
        </p>
      </div>
    </div>
  </div>

  <div class="block">
    <div class="cols">
      <div class="gc-1-5">
        <h3 class="p-label">Earlier character</h3>
        <div class="after-label">
          <Image src={earlier} alt="Earlier version of the character" widths={[600, 900, 1400]} sizes="(max-width: 1260px) 100vw, 741px" loading="lazy" class="media-img" />
        </div>
      </div>
      <div class="gc-7-2 below-label">
        <h3 class="p-label">What I kept</h3>
        <ul class="p-list after-label">
          {kept.map(item => <li>{item}</li>)}
        </ul>
        <h3 class="p-label block-gap">What I left behind</h3>
        <ul class="p-list after-label">
          {leftBehind.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="block">
    <h3 class="p-label">Design draft</h3>
    <div class="cols after-label">
      <div class="gc-1-8">
        <Image src={firstDesign} alt="First design draft of the character" widths={[800, 1200, 1800]} sizes="(max-width: 1440px) 100vw, 1200px" loading="lazy" class="media-img" />
      </div>
    </div>
    <div class="cols block-gap">
      {draft.map((items, i) => (
        <div class={draftCols[i]}>
          <ul class="p-list">
            {items.map(item => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="block">
    <div class="cols">
      <div class="gc-1-5">
        <h3 class="p-label">Final design</h3>
        <div class="after-label">
          <Image src={finalDesign} alt="Final character design" widths={[634]} sizes="(max-width: 1260px) 100vw, 741px" loading="lazy" class="media-img" />
        </div>
      </div>
      <div class="gc-7-2 below-label">
        <ul class="p-list">
          {final.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</ProjectSection>
