---
import DepartureCredits from '../credits/DepartureCredits.astro';
import SideMenu from '../sanctuary/SideMenu.astro';
import TrailerPlayer from '../sanctuary/TrailerPlayer.astro';
import cover from '@assets/projects/departure-title-image.jpg';

const menuLinks = [
  { label: 'OVERVIEW', href: '#top' },
  { label: 'CONTRIBUTION', href: '#contribution' },
  { label: 'ANIMATION', href: '#animation' },
  { label: 'CHARACTER DESIGN', href: '#character-design' },
  { label: 'ENVIRONMENT DESIGN', href: '#environment-design' },
  { label: 'CONTACT', href: '#contact' },
];

const trailerSrc = 'https://www.youtube-nocookie.com/embed/N4glTtSFdqg';
---

<section class="hero grid-1440" id="top">
  <SideMenu links={menuLinks} />

  <div class="inner">
    <h1>Departure</h1>
    <p class="type">Solo project · Game Animation course · 2025</p>

    <div class="trailer">
      <TrailerPlayer cover={cover} src={trailerSrc} title="Departure trailer" />
    </div>

    <div class="cols info">
      <div class="gc-1-3">
        <h3 class="p-label">Project description</h3>
        <div class="after-label">
          <p class="p-text">
            Departure is a game animation project that combines a 2D character with a stylized 3D
            environment. It presents a full set of animations for a platformer character, built in
            Spine 2D and connected to player controls in Unity.
          </p>
          <p class="p-text">
            The character was designed around the idea of a gentle giant: shy and fragile by
            nature, yet remarkably strong, which shows in her powerful arms and large tail. She
            moves through a series of mysterious caverns with towering rock formations.
          </p>
        </div>
      </div>
      <div class="gc-5-3">
        <h3 class="p-label">Credits</h3>
        <div class="after-label">
          <DepartureCredits cls="p-text" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(128px - var(--nav-height));
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .inner {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .type {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #9a9a9a;
  }

  @supports (text-box-trim: trim-both) {
    h1 {
      text-box: trim-end cap alphabetic;
    }

    .type {
      margin-top: 32px;
      text-box: trim-start cap alphabetic;
    }
  }

  .trailer {
    position: relative;
    width: 100%;
    max-width: 894px;
    aspect-ratio: 894 / 503;
    margin-top: 64px;
    background: rgba(217, 217, 217, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .trailer iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .info {
    margin-top: 96px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }

    .type {
      font-size: 1.25rem;
    }
  }
</style>
