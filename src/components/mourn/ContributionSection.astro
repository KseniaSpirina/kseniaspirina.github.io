---
import ProjectSection from '../imprisoned/ProjectSection.astro';

const challenge = [
  'Tell a story about grief and sudden loss in a short, playable format',
  'Let conversation and player choice carry the emotional weight of the story',
  'Handle a sensitive subject, including a depiction of a fatal accident, with care',
  'Take the project from idea to release alone: concept, visuals, and programming',
  'Develop the full game within a 2-month production timeline',
];

const role = [
  'Concept, story, and narrative design',
  'Game design: conversation and choice',
  'Visual design and art',
  'Programming with visual scripting',
  'Release on itch.io for Windows and macOS',
];

---

<ProjectSection id="contribution" title="Contribution">
  <div class="cols">
    <div class="gc-1-2">
      <h3 class="p-label">Challenge</h3>
      <ul class="p-list hang loose after-label">
        {challenge.map(item => <li set:html={item} />)}
      </ul>
    </div>
    <div class="gc-5-2">
      <h3 class="p-label">My role</h3>
      <ul class="p-list hang loose after-label">
        {role.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</ProjectSection>
