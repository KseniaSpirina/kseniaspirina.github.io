---
import { Image } from 'astro:assets';
import SideMenu from '../sanctuary/SideMenu.astro';
import ItchButton from '../project/ItchButton.astro';
import cover from '@assets/mourn/trailer-cover.jpg';

const menuLinks = [
  { label: 'OVERVIEW', href: '#top' },
  { label: 'CONTRIBUTION', href: '#contribution' },
  { label: 'STORY DEVELOPMENT', href: '#story-development' },
  { label: 'CHARACTERS DESIGN', href: '#characters-design' },
  { label: 'ENVIRONMENT DESIGN', href: '#environment-design' },
  { label: 'MECHANICS AND UI', href: '#mechanics-and-ui' },
  { label: 'CONTACT', href: '#contact' },
];

// The trailer is age-restricted on YouTube, so it cannot be embedded: show a cover that opens it.
// Once the restriction is lifted, set embedSrc to 'https://www.youtube-nocookie.com/embed/NDXf0gJobd8'.
const watchUrl = 'https://www.youtube.com/watch?v=NDXf0gJobd8';
const embedSrc: string | null = null;
---

<section class="hero grid-1440" id="top">
  <SideMenu links={menuLinks} />

  <div class="inner">
    <h1>Mourn</h1>
    <p class="type">Solo project · Indi Games course · 2025</p>

    <div class="trailer">
      {embedSrc ? (
        <iframe
          src={embedSrc}
          title="Mourn trailer"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      ) : (
        <a class="cover" href={watchUrl} target="_blank" rel="noopener noreferrer" aria-label="Watch the Mourn trailer on YouTube">
          <Image src={cover} alt="" widths={[600, 900, 1400]} sizes="(max-width: 1440px) 70vw, 894px" loading="eager" />
          <span class="play" aria-hidden="true">
            <svg width="28" height="32" viewBox="0 0 28 32" fill="currentColor"><path d="M2 2.5v27a1 1 0 0 0 1.5.9l23-13.5a1 1 0 0 0 0-1.8L3.5 1.6A1 1 0 0 0 2 2.5z" /></svg>
          </span>
        </a>
      )}
    </div>

    <div class="cols info">
      <div class="gc-1-3">
        <h3 class="p-label">Project description</h3>
        <div class="after-label">
          <p class="p-text">
            Mourn is a short narrative game about grief, memory, and the regrets that remain after
            sudden loss. Through conversation and choice, it explores how we carry pain, and the
            strength it takes to face it.
          </p>
          <p class="p-text">
            <strong>Content warning:</strong> the game contains themes of grief and trauma,
            including a depiction of a fatal accident. Some content may be distressing to certain
            players.
          </p>
        </div>
        <ItchButton href="https://ksenia-spirina.itch.io/mourn" />
      </div>
      <div class="gc-5-3">
        <h3 class="p-label">Credits</h3>
        <div class="after-label">
          <p class="p-text keep-host">
            Mourn was created as an assignment in the course "Indi Games",
            <span class="keep-dept">Visual <span class="keep-always">Communication Department,</span></span>
            <span class="keep-name"><span class="keep-always">Bezalel Academy of Arts and</span> Design,</span> 2025.
          </p>
          <p class="p-text"><strong>Author:</strong> Ksenia Spirina</p>
          <p class="p-text"><strong>Guidance:</strong> Dani Bacon</p>
          <p class="p-text"><strong>Assistance:</strong> Yotam Mano and Lila Egoz</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(128px - var(--nav-height));
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .inner {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .type {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #9a9a9a;
  }

  @supports (text-box-trim: trim-both) {
    h1 {
      text-box: trim-end cap alphabetic;
    }

    .type {
      margin-top: 32px;
      text-box: trim-start cap alphabetic;
    }
  }

  .trailer {
    position: relative;
    width: 100%;
    max-width: 894px;
    aspect-ratio: 894 / 503;
    margin-top: 64px;
    background: rgba(217, 217, 217, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .trailer iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .cover {
    position: absolute;
    inset: 0;
    display: block;
    color: #e8e8e8;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 88px;
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 6px;
    transform: translate(-50%, -50%);
    border: 2px solid currentColor;
    border-radius: 50%;
    background: rgba(18, 18, 18, 0.55);
    transition: color 150ms ease, background-color 150ms ease;
  }

  .cover:hover {
    color: #4361ee;
  }

  .cover:hover .play {
    background: rgba(18, 18, 18, 0.8);
  }

  .info {
    margin-top: 96px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }

    .type {
      font-size: 1.25rem;
    }
  }
</style>
