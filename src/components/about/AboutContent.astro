---
import { Image } from 'astro:assets';
import portrait from '@assets/about/portrait.jpg';

import envelopeIcon from '@assets/icons/envelope.svg?raw';
import instagramIcon from '@assets/icons/instagram.svg?raw';
import linkedinIcon from '@assets/icons/linkedin.svg?raw';
import '../../styles/buttons.css';

import photoshopIcon from '@assets/icons/photoshop.svg';
import indesignIcon from '@assets/icons/indesign.svg';
import illustratorIcon from '@assets/icons/illustrator.svg';
import unityIcon from '@assets/icons/unity.svg';
import procreateIcon from '@assets/icons/procreate.svg';
import cinema4dIcon from '@assets/icons/cinema4d.svg';
import blenderIcon from '@assets/icons/blender.svg';
import nomadIcon from '@assets/icons/nomad.svg';
import spine2dIcon from '@assets/icons/spine2d.svg';

const skills = [
  { label: 'Adobe', icons: [photoshopIcon, indesignIcon, illustratorIcon] },
  { label: 'Game Engine', icons: [unityIcon] },
  { label: 'Drawing', icons: [procreateIcon] },
  { label: 'Modeling', icons: [cinema4dIcon, blenderIcon, nomadIcon] },
  { label: 'Animation', icons: [spine2dIcon] },
];
---

<h1 class="page-title">About Me</h1>

<div class="about-grid">
  <div class="left-col">
    <Image class="portrait" src={portrait} alt="Ksenia Spirina" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />

    <h2 class="p-subhead cta-title">Let’s work together!</h2>
    <div class="contact-buttons">
      <a class="btn btn--primary" href="mailto:kseniaspirina@gmail.com">
        <Fragment set:html={envelopeIcon} />
        <span>Email me</span>
      </a>
      <a class="btn" href="https://instagram.com/morkespi" target="_blank" rel="noopener noreferrer">
        <Fragment set:html={instagramIcon} />
        <span>Instagram</span>
      </a>
      <a class="btn" href="https://www.linkedin.com/in/ksenia-spirina-24b87b384/" target="_blank" rel="noopener noreferrer">
        <Fragment set:html={linkedinIcon} />
        <span>LinkedIn</span>
      </a>
    </div>
  </div>

  <div class="right-col">
    <p class="p-text">
      <strong class="display">HELLO!</strong> I’m <strong class="accent">Ksenia Spirina</strong>, a visual designer
      focused on game development. I create idea-driven experiences where art serves as a
      storytelling tool.
    </p>
    <p class="p-text">
      Every project starts with an idea, whether it’s from a story, a mechanic, or a meaning, an
      experience I want the player to come away with. From there, I research how to translate the
      idea into design. I study references, visual tropes, and how others have communicated
      something similar. Only then do I define the visual direction.
    </p>
    <p class="p-text">
      My work spans
      <strong class="accent">interaction design, concept art, environment design, 2D animation, illustration, UI, VFX, and worldbuilding</strong>.
      I develop projects both independently and as part of a team, creating experiences that
      engage players and leave them with something to reflect on.
    </p>

    <h3 class="p-label block-label">Education</h3>
    <p class="p-text after-label">
      Bachelor of Arts (B.A.) in Visual Communication<br />
      Bezalel Academy of Arts and Design<br />
      2022-2026
    </p>

    <h3 class="p-label block-label">Software</h3>
    <div class="skills after-label">
      {skills.map(skill => (
        <div class="skill-row">
          <span class="skill-name">{skill.label}</span>
          <div class="skill-icons">
            {skill.icons.map(icon => (
              <img src={icon.src} alt="" width="53" height="53" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* About page in the new style: body text and labels come from project.css (.p-text, .p-label, .p-subhead),
     buttons from buttons.css. Distances are measured glyph to glyph (see the typography rules). */
  .page-title {
    /* title -> portrait / first text: 64px (24px grid gap + 40px) */
    margin: 0 0 40px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.25;
    color: #4361ee;
    text-transform: uppercase;
  }

  @supports (text-box-trim: trim-both) {
    .page-title {
      text-box: trim-end cap alphabetic;
    }
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    column-gap: 24px;
  }

  .left-col {
    grid-column: 1 / span 3;
  }

  .right-col {
    grid-column: 5 / span 3;
  }

  /* Instagram icon: same height as the LinkedIn icon used to have (40px), so the button stays 60px tall */
  .contact-buttons :global(.btn svg[width='41']) {
    height: 40px;
    width: auto;
  }

  .portrait {
    display: block;
    width: 100%;
    aspect-ratio: 435 / 549;
    object-fit: cover;
    border-radius: 4px;
  }

  /* portrait -> subhead 96px, subhead -> buttons 48px */
  .cta-title {
    margin: 96px 0 0;
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 48px;
  }

  /* HELLO!: Unbounded, same colour as the subheads */
  .right-col :global(strong.display) {
    font-family: var(--font-display);
    font-weight: 700;
    color: #e8e8e8;
  }

  /* blue highlight inside the text: Inter Bold #5E77E8 */
  .right-col :global(strong.accent) {
    font-weight: 700;
    color: #5e77e8;
  }

  /* text -> label 96px */
  .block-label {
    margin: 96px 0 0;
  }

  .skills {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
  }

  .skill-row {
    display: flex;
    align-items: center;
  }

  .skill-name {
    flex: 0 0 153px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 18px;
    line-height: 27px;
    color: #d6d6d6;
  }

  .skill-icons {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .skill-icons img {
    display: block;
    width: 53px;
    height: 53px;
  }

  /* stacked layout: portrait, then the text, Education, Software, and only then "Let's work together!" with the buttons */
  @media (max-width: 1260px) {
    .about-grid {
      grid-template-columns: repeat(4, 1fr);
      row-gap: 0;
    }

    .left-col {
      display: contents;
    }

    .portrait {
      grid-column: 1 / span 2;
      order: 1;
    }

    .right-col {
      grid-column: 1 / -1;
      order: 2;
      /* portrait -> text 64px */
      margin-top: 64px;
    }

    /* Software icons -> subhead 96px, subhead -> buttons 48px */
    .cta-title {
      grid-column: 1 / -1;
      order: 3;
      margin-top: 96px;
    }

    .contact-buttons {
      grid-column: 1 / -1;
      order: 4;
    }
  }

  @media (max-width: 640px) {
    /* the grid gap is 16px here: 48 + 16 = 64px to the portrait */
    .page-title {
      margin-bottom: 48px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .left-col,
    .right-col {
      grid-column: 1 / -1;
    }

    .portrait {
      grid-column: 1 / -1;
      max-width: 320px;
    }

    .skill-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .skill-name {
      flex-basis: auto;
    }
  }
</style>
