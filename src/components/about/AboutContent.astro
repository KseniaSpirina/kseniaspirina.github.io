---
import { Image } from 'astro:assets';
import portrait from '@assets/about/portrait.jpg';

import envelopeIcon from '@assets/icons/envelope.svg?raw';
import instagramIcon from '@assets/icons/instagram.svg?raw';
import linkedinIcon from '@assets/icons/linkedin.svg?raw';

import photoshopIcon from '@assets/icons/photoshop.svg';
import indesignIcon from '@assets/icons/indesign.svg';
import illustratorIcon from '@assets/icons/illustrator.svg';
import unityIcon from '@assets/icons/unity.svg';
import procreateIcon from '@assets/icons/procreate.svg';
import cinema4dIcon from '@assets/icons/cinema4d.svg';
import blenderIcon from '@assets/icons/blender.svg';
import nomadIcon from '@assets/icons/nomad.svg';
import spine2dIcon from '@assets/icons/spine2d.svg';

const skills = [
  { label: 'Adobe', icons: [photoshopIcon, indesignIcon, illustratorIcon] },
  { label: 'Game Engine', icons: [unityIcon] },
  { label: 'Drawing', icons: [procreateIcon] },
  { label: 'Modeling', icons: [cinema4dIcon, blenderIcon, nomadIcon] },
  { label: 'Animation', icons: [spine2dIcon] },
];
---

<h1 class="page-title">About Me</h1>

<div class="about-grid">
  <div class="left-col">
    <Image class="portrait" src={portrait} alt="Ksenia Spirina" widths={[400, 700, 900]} sizes="(max-width: 768px) 100vw, 435px" />

    <h2 class="cta-title">Let's Work Together!</h2>
    <div class="contact-buttons">
      <a class="contact-btn" href="mailto:kseniaspirina@gmail.com">
        <Fragment set:html={envelopeIcon} />
        <span>Email me</span>
      </a>
      <a class="contact-btn" href="https://instagram.com/morkespi" target="_blank" rel="noopener noreferrer">
        <Fragment set:html={instagramIcon} />
        <span>Instagram</span>
      </a>
      <a class="contact-btn" href="https://www.linkedin.com/in/ksenia-spirina-24b87b384/" target="_blank" rel="noopener noreferrer">
        <Fragment set:html={linkedinIcon} />
        <span>LinkedIn</span>
      </a>
    </div>
  </div>

  <div class="right-col">
    <p class="bio">
      <strong class="display">HELLO!</strong> I'm <strong class="accent">Ksenia Spirina</strong>, a visual designer
      focused on game development. I create idea-driven experiences where art serves as a
      storytelling tool.
    </p>
    <p class="bio">
      Every project starts with an idea, whether it's from a story, a mechanic, or a meaning, an
      experience I want the player to come away with. From there, I research how to translate the
      idea into design. I study references, visual tropes, and how others have communicated
      something similar. Only then do I define the visual direction.
    </p>
    <p class="bio">
      My work spans
      <strong class="accent">interaction design, concept art, environment design, 2D animation, illustration, UI, VFX, and worldbuilding</strong>.
      I develop projects both independently and as part of a team, creating experiences that
      engage players and leave them with something to reflect on.
    </p>

    <h3 class="section-label">Education</h3>
    <p class="edu-text">
      Bachelor of Arts (B.A.) in Visual Communication<br />
      Bezalel Academy of Arts and Design<br />
      2022-2026
    </p>

    <h3 class="section-label software-label">Software</h3>
    <div class="skills">
      {skills.map(skill => (
        <div class="skill-row">
          <span class="skill-name">{skill.label}</span>
          <div class="skill-icons">
            {skill.icons.map(icon => (
              <img src={icon.src} alt="" width="53" height="53" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .page-title {
    /* 64px to the portrait: 24px grid gap + 40px */
    margin: 0 0 40px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.25;
    color: #4361ee;
    text-transform: uppercase;
  }

  @supports (text-box-trim: trim-both) {
    .page-title {
      text-box: trim-end cap alphabetic;
    }
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    column-gap: 24px;
  }

  .left-col {
    grid-column: 1 / span 3;
  }

  .right-col {
    grid-column: 5 / span 3;
    margin-top: -8px;
  }

  .portrait {
    display: block;
    width: 100%;
    aspect-ratio: 435 / 549;
    object-fit: cover;
    border-radius: 4px;
  }

  .cta-title {
    margin: 59px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: #e8e8e8;
    text-transform: uppercase;
  }

  .contact-buttons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 26px;
  }

  .contact-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #e8e8e8;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 26px;
    transition: color 150ms ease;
  }

  .contact-btn :global(svg) {
    display: block;
    flex-shrink: 0;
  }

  .contact-btn::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) {
    .contact-btn:hover {
      color: #4361ee;
  }
  }

  @media (hover: hover) {
    .contact-btn:hover::after {
      opacity: 1;
  }
  }

  .bio {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 26px;
    color: #e8e8e8;
  }

  .bio + .bio {
    margin-top: 26px;
  }

  .bio strong {
    font-weight: 700;
  }

  .bio strong.accent {
    color: #4361ee;
  }

  .bio strong.display {
    font-family: var(--font-display);
  }

  .section-label {
    margin: 53px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: #e8e8e8;
    text-transform: uppercase;
  }

  .edu-text {
    margin: 18px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    line-height: 26px;
    color: #e8e8e8;
  }

  .skills {
    display: flex;
    flex-direction: column;
    row-gap: 24px;
    margin-top: 41px;
  }

  .skill-row {
    display: flex;
    align-items: center;
  }

  .skill-name {
    flex: 0 0 153px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.125rem;
    color: #e8e8e8;
  }

  .skill-icons {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .skill-icons img {
    display: block;
    width: 53px;
    height: 53px;
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: repeat(4, 1fr);
      row-gap: 3rem;
    }

    .left-col {
      grid-column: 1 / span 2;
    }

    .right-col {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .left-col,
    .right-col {
      grid-column: 1 / -1;
    }

    .portrait {
      max-width: 320px;
    }

    .skill-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .skill-name {
      flex-basis: auto;
    }
  }
</style>
