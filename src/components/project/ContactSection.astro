---
import ProjectSection from '../imprisoned/ProjectSection.astro';
import envelopeIcon from '@assets/icons/envelope.svg?raw';
import linkedinIcon from '@assets/icons/linkedin.svg?raw';
import '../../styles/buttons.css';
---

<ProjectSection id="contact" title="Contact">
  <h3 class="heading">Let’s work together!</h3>
  <div class="buttons">
    <a class="btn btn--primary" href="mailto:kseniaspirina@gmail.com">
      <Fragment set:html={envelopeIcon} />
      <span>Email me</span>
    </a>
    <a class="btn" href="https://www.linkedin.com/in/ksenia-spirina-24b87b384/" target="_blank" rel="noopener noreferrer">
      <Fragment set:html={linkedinIcon} />
      <span>LinkedIn</span>
    </a>
  </div>
  <div class="address">
    <a class="address-link" href="mailto:kseniaspirina@gmail.com">kseniaspirina@gmail.com</a>
    <button class="btn btn--secondary" type="button" data-copy="kseniaspirina@gmail.com" aria-live="polite">Copy</button>
  </div>
</ProjectSection>

<script>
  // Copy button: puts the e-mail address on the clipboard and says "Copied" for two seconds
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const area = document.createElement('textarea');
        area.value = value;
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        area.remove();
      }
      const label = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => {
        btn.textContent = label;
      }, 2000);
    });
  });
</script>

<style>
  .heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #e8e8e8;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 32px;
  }

  /* buttons -> address 48px (button edge to the lowercase letters); same row as on the Contact page */
  .address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    /* row is 37px tall (Copy button), the 27px line is centred in it: lowercase letters start 15.17px below its top */
    margin-top: 32.83px;
  }

  .address-link {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 27px;
    color: #d6d6d6;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 150ms ease;
  }

  @media (hover: hover) {
    .address-link:hover {
      color: #4361ee;
    }
  }
</style>
