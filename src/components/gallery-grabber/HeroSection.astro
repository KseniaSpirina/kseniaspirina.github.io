---
import GalleryGrabberCredits from '../credits/GalleryGrabberCredits.astro';
import { Image } from 'astro:assets';
import SideMenu from '../sanctuary/SideMenu.astro';
import cover from '@assets/projects/gallery-grabber-title-image.jpg';

const menuLinks = [
  { label: 'OVERVIEW', href: '#top' },
  { label: 'CONTRIBUTION', href: '#contribution' },
  { label: 'CHARACTER DESIGN', href: '#character-design' },
  { label: 'ANIMATION', href: '#animation' },
  { label: 'ENVIRONMENT DESIGN', href: '#environment-design' },
  { label: 'ASSETS DESIGN', href: '#assets-design' },
  { label: 'CONTACT', href: '#contact' },
];
---

<section class="hero grid-1440" id="top">
  <SideMenu links={menuLinks} />

  <div class="inner">
    <h1>Gallery Grabber</h1>
    <p class="type">Team project · Game Lab course · 2025</p>

    <div class="trailer">
      <Image src={cover} alt="Rose, the museum janitor, in Gallery Grabber" widths={[600, 900, 1400]} sizes="(max-width: 1440px) 70vw, 894px" loading="eager" />
    </div>

    <div class="cols info">
      <div class="gc-1-3">
        <h3 class="p-label">Project description</h3>
        <div class="after-label">
          <p class="p-text">
            Gallery Grabber is a top-down stealth game with a comedic, slightly grotesque edge. The
            player takes on the role of Rose, a museum janitor who has decided to change her life:
            leave for warmer shores and live in luxury. To fund her escape, she plans to steal
            artifacts from the museum where she works.
          </p>
          <p class="p-text">
            To pull off the heist, the player has to stay out of the security cameras’ beams and the
            guards’ line of sight. At the same time, Rose still has a job to do: the player must
            collect trash around the map, or she’ll be fired for neglecting her duties before her
            plan is complete.
          </p>
        </div>
      </div>
      <div class="gc-5-3">
        <h3 class="p-label">Credits</h3>
        <div class="after-label">
          <GalleryGrabberCredits cls="p-text" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(128px - var(--nav-height));
    padding-bottom: 128px;
    scroll-margin-top: calc(var(--nav-height) + 1rem);
  }

  .inner {
    grid-column: 1 / -1;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.25;
    text-transform: uppercase;
    color: #4361ee;
  }

  .type {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #9a9a9a;
  }

  @supports (text-box-trim: trim-both) {
    h1 {
      text-box: trim-end cap alphabetic;
    }

    .type {
      margin-top: 32px;
      text-box: trim-start cap alphabetic;
    }
  }

  .trailer {
    position: relative;
    width: 100%;
    max-width: 894px;
    aspect-ratio: 894 / 503;
    margin-top: 64px;
    background: rgba(217, 217, 217, 0.1);
    border-radius: 4px;
    overflow: hidden;
  }

  .trailer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    margin-top: 96px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 2.25rem;
    }

    .type {
      font-size: 1.25rem;
    }
  }
</style>
