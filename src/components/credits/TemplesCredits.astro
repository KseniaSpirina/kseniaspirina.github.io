---
interface Props {
  /** class of the paragraphs: 'text' on the Sanctuary page, 'p-text' elsewhere */
  cls?: string;
}
const { cls = 'p-text' } = Astro.props;
---

  <p class:list={[cls, 'keep-host']}>
    Project was created for an Imagemaking in&nbsp;3d course,
    <span class="keep-name"><span class="keep-always">Bezalel Academy of Arts and</span> Design</span> 2026.
  </p>
  <p class={cls}><strong>Designer:</strong> Ksenia Spirina</p>
  <p class={cls}><strong>Guidance:</strong> Eli Magaziner</p>
